---
import '../../../src/styles/global.css';
import { DEFAULT_CATEGORIES } from '../../../src/lib/shop';
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/x-icon" href="/tk.ico" />
    <title>Admin | Tansaku</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="adm-top">
      <div class="adm-wrap adm-top-inner">
        <p class="adm-brand">
          <span>探索</span> Tansaku <small>Admin</small>
        </p>
        <div class="adm-top-actions">
          <a href="https://tansaku.site/catalogo/" target="_blank" rel="noopener"
            >Ver catálogo ↗</a
          >
          <button type="button" id="logout" class="adm-btn-ghost" hidden
            >Cerrar sesión</button
          >
        </div>
      </div>
    </header>

    <main class="adm-wrap">
      <!-- Missing configuration -->
      <section id="view-config" class="adm-card adm-narrow" hidden>
        <h1 class="adm-h1">Falta configurar Supabase</h1>
        <p class="adm-muted">
          Define <code>PUBLIC_SUPABASE_URL</code> y
          <code>PUBLIC_SUPABASE_ANON_KEY</code> al compilar el panel. Mira
          <code>ADMIN.md</code> en el repositorio.
        </p>
      </section>

      <!-- Loading -->
      <section id="view-loading" class="adm-narrow">
        <p class="adm-muted">Cargando…</p>
      </section>

      <!-- Login -->
      <section id="view-login" class="adm-card adm-narrow" hidden>
        <h1 class="adm-h1">Iniciar sesión</h1>
        <form id="login-form" class="adm-form">
          <label class="adm-field">
            <span>Correo</span>
            <input name="email" type="email" required autocomplete="username" />
          </label>
          <label class="adm-field">
            <span>Contraseña</span>
            <input
              name="password"
              type="password"
              required
              autocomplete="current-password"
            />
          </label>
          <button type="submit" class="adm-btn">Entrar</button>
          <p id="login-error" class="adm-error" role="alert" hidden></p>
        </form>
      </section>

      <!-- Logged in but not an admin -->
      <section id="view-denied" class="adm-card adm-narrow" hidden>
        <h1 class="adm-h1">Sin permiso</h1>
        <p class="adm-muted">
          Esta cuenta (<strong id="denied-email"></strong>) no es administradora.
          Agrégala a la tabla <code>admins</code> en Supabase (ver
          <code>ADMIN.md</code>).
        </p>
      </section>

      <!-- Dashboard -->
      <section id="view-app" hidden>
        <div class="adm-grid">
          <div class="adm-card adm-editor">
            <h1 id="editor-title" class="adm-h1">Nueva publicación</h1>
            <form id="product-form" class="adm-form">
              <input type="hidden" name="id" />

              <div class="adm-photo">
                <label class="adm-photo-drop" for="p-image">
                  <img id="p-preview" alt="" hidden />
                  <span id="p-photo-hint">Toca para subir una foto</span>
                </label>
                <input
                  id="p-image"
                  name="image"
                  type="file"
                  accept="image/jpeg,image/png,image/webp,image/avif,image/heic"
                  hidden
                />
                <button
                  type="button"
                  id="p-image-remove"
                  class="adm-btn-ghost adm-btn-sm"
                  hidden>Quitar foto</button
                >
              </div>

              <label class="adm-field">
                <span>Título *</span>
                <input name="title" required maxlength="160" />
              </label>

              <div class="adm-row">
                <label class="adm-field">
                  <span>Precio (RD$) *</span>
                  <input
                    name="price"
                    type="number"
                    inputmode="decimal"
                    min="0"
                    step="0.01"
                    required
                  />
                </label>
                <label class="adm-field">
                  <span>Categoría *</span>
                  <input
                    name="category"
                    list="category-options"
                    required
                    maxlength="60"
                    placeholder="Elige o escribe una"
                  />
                  <datalist id="category-options">
                    {DEFAULT_CATEGORIES.map((c) => <option value={c} />)}
                  </datalist>
                </label>
              </div>

              <label class="adm-field">
                <span>Descripción</span>
                <textarea name="description" rows="3" maxlength="2000"></textarea>
              </label>

              <div class="adm-row adm-checks">
                <label class="adm-check">
                  <input name="in_stock" type="checkbox" checked /> Disponible
                </label>
                <label class="adm-check">
                  <input name="published" type="checkbox" checked /> Visible en el
                  catálogo
                </label>
              </div>

              <div class="adm-actions">
                <button type="submit" id="p-submit" class="adm-btn"
                  >Publicar</button
                >
                <button
                  type="button"
                  id="p-cancel"
                  class="adm-btn-ghost"
                  hidden>Cancelar edición</button
                >
              </div>
              <p id="p-status" class="adm-muted" role="status"></p>
            </form>
          </div>

          <div class="adm-list-col">
            <div class="adm-list-head">
              <h2 class="adm-h2">
                Publicaciones <span id="list-count" class="adm-muted"></span>
              </h2>
              <input
                id="list-search"
                type="search"
                placeholder="Buscar…"
                aria-label="Buscar publicaciones"
              />
            </div>
            <ul id="product-list" class="adm-list"></ul>
            <p id="list-empty" class="adm-muted" hidden>
              Todavía no hay publicaciones. Crea la primera a la izquierda.
            </p>
          </div>
        </div>
      </section>
    </main>

    <script>
      import {
        getClient,
        imageUrl,
        formatPrice,
        IMAGES_BUCKET,
        type Product,
      } from '../../../src/lib/shop';

      const $ = <T extends HTMLElement>(id: string) =>
        document.getElementById(id) as T;

      const views = ['config', 'loading', 'login', 'denied', 'app'] as const;
      function show(view: (typeof views)[number]) {
        for (const v of views) $(`view-${v}`).hidden = v !== view;
        $('logout').hidden = view !== 'app' && view !== 'denied';
      }

      const supabase = getClient();

      if (!supabase) {
        show('config');
      } else {
        const sb = supabase;
        let products: Product[] = [];
        let pendingFile: Blob | null = null;
        let removeImage = false;
        let editing: Product | null = null;
        let previewUrl: string | null = null;

        // ── Auth ──────────────────────────────────────────
        async function route() {
          const {
            data: { session },
          } = await sb.auth.getSession();
          if (!session) return show('login');

          const { data: isAdmin, error } = await sb.rpc('is_admin');
          if (error || !isAdmin) {
            $('denied-email').textContent = session.user.email ?? '';
            return show('denied');
          }
          show('app');
          await loadProducts();
        }

        $<HTMLFormElement>('login-form').addEventListener('submit', async (e) => {
          e.preventDefault();
          const form = e.currentTarget as HTMLFormElement;
          const fd = new FormData(form);
          const err = $('login-error');
          err.hidden = true;
          const btn = form.querySelector('button')!;
          btn.disabled = true;
          const { error } = await sb.auth.signInWithPassword({
            email: String(fd.get('email')),
            password: String(fd.get('password')),
          });
          btn.disabled = false;
          if (error) {
            err.textContent = 'Correo o contraseña incorrectos.';
            err.hidden = false;
            return;
          }
          form.reset();
          route();
        });

        $('logout').addEventListener('click', async () => {
          await sb.auth.signOut();
          show('login');
        });

        // ── Products list ─────────────────────────────────
        async function loadProducts() {
          const { data, error } = await sb
            .from('products')
            .select('*')
            .order('created_at', { ascending: false });
          if (error) {
            alert(`No se pudieron cargar las publicaciones: ${error.message}`);
            return;
          }
          products = (data ?? []) as Product[];
          renderList();
        }

        function renderList() {
          const q = $<HTMLInputElement>('list-search').value.trim().toLowerCase();
          const list = products.filter(
            (p) => !q || `${p.title} ${p.category}`.toLowerCase().includes(q),
          );
          $('list-count').textContent = `(${products.length})`;
          $('list-empty').hidden = products.length > 0;

          $('product-list').replaceChildren(
            ...list.map((p) => {
              const li = document.createElement('li');
              li.className = 'adm-item';
              if (!p.published) li.classList.add('is-hidden');

              const thumb = document.createElement('div');
              thumb.className = 'adm-thumb';
              const src = imageUrl(p.image_path);
              if (src) {
                const img = document.createElement('img');
                img.src = src;
                img.alt = '';
                img.loading = 'lazy';
                thumb.append(img);
              }

              const info = document.createElement('div');
              info.className = 'adm-item-info';
              const t = document.createElement('p');
              t.className = 'adm-item-title';
              t.textContent = p.title;
              const meta = document.createElement('p');
              meta.className = 'adm-item-meta';
              meta.textContent = `${formatPrice(Number(p.price))} · ${p.category}`;
              const tags = document.createElement('p');
              tags.className = 'adm-item-tags';
              if (!p.published) tags.append(tag('Oculto', 'gray'));
              if (!p.in_stock) tags.append(tag('Agotado', 'red'));
              info.append(t, meta, tags);

              const actions = document.createElement('div');
              actions.className = 'adm-item-actions';
              actions.append(
                action('Editar', () => startEdit(p)),
                action(p.in_stock ? 'Marcar agotado' : 'Marcar disponible', () =>
                  quickUpdate(p, { in_stock: !p.in_stock }),
                ),
                action(p.published ? 'Ocultar' : 'Mostrar', () =>
                  quickUpdate(p, { published: !p.published }),
                ),
                action('Borrar', () => remove(p), true),
              );

              li.append(thumb, info, actions);
              return li;
            }),
          );
        }

        function tag(text: string, color: 'gray' | 'red') {
          const s = document.createElement('span');
          s.className = `adm-tag adm-tag-${color}`;
          s.textContent = text;
          return s;
        }

        function action(label: string, fn: () => void, danger = false) {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = danger ? 'adm-link adm-link-danger' : 'adm-link';
          b.textContent = label;
          b.addEventListener('click', fn);
          return b;
        }

        $('list-search').addEventListener('input', renderList);

        async function quickUpdate(p: Product, patch: Partial<Product>) {
          const { error } = await sb.from('products').update(patch).eq('id', p.id);
          if (error) return alert(error.message);
          Object.assign(p, patch);
          renderList();
        }

        async function remove(p: Product) {
          if (!confirm(`¿Borrar "${p.title}"? Esto no se puede deshacer.`)) return;
          const { error } = await sb.from('products').delete().eq('id', p.id);
          if (error) return alert(error.message);
          if (p.image_path) await sb.storage.from(IMAGES_BUCKET).remove([p.image_path]);
          products = products.filter((x) => x.id !== p.id);
          if (editing?.id === p.id) resetEditor();
          renderList();
        }

        // ── Editor ────────────────────────────────────────
        const form = $<HTMLFormElement>('product-form');
        const fileInput = $<HTMLInputElement>('p-image');
        const preview = $<HTMLImageElement>('p-preview');
        const status = $('p-status');

        function setPreview(src: string | null) {
          if (previewUrl) URL.revokeObjectURL(previewUrl);
          previewUrl = src?.startsWith('blob:') ? src : null;
          preview.hidden = !src;
          if (src) preview.src = src;
          else preview.removeAttribute('src');
          $('p-photo-hint').hidden = Boolean(src);
          $('p-image-remove').hidden = !src;
        }

        function field<T extends HTMLInputElement | HTMLTextAreaElement>(name: string) {
          return form.elements.namedItem(name) as T;
        }

        function resetEditor() {
          editing = null;
          pendingFile = null;
          removeImage = false;
          form.reset();
          field('id').value = '';
          setPreview(null);
          $('editor-title').textContent = 'Nueva publicación';
          $('p-submit').textContent = 'Publicar';
          $('p-cancel').hidden = true;
        }

        function startEdit(p: Product) {
          resetEditor();
          editing = p;
          field('id').value = p.id;
          field('title').value = p.title;
          field('price').value = String(p.price);
          field('category').value = p.category;
          field('description').value = p.description ?? '';
          field<HTMLInputElement>('in_stock').checked = p.in_stock;
          field<HTMLInputElement>('published').checked = p.published;
          setPreview(imageUrl(p.image_path));
          $('editor-title').textContent = 'Editar publicación';
          $('p-submit').textContent = 'Guardar cambios';
          $('p-cancel').hidden = false;
          status.textContent = '';
          form.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        $('p-cancel').addEventListener('click', resetEditor);

        $('p-image-remove').addEventListener('click', () => {
          pendingFile = null;
          removeImage = true;
          fileInput.value = '';
          setPreview(null);
        });

        fileInput.addEventListener('change', async () => {
          const file = fileInput.files?.[0];
          if (!file) return;
          status.textContent = 'Preparando foto…';
          try {
            pendingFile = await compressImage(file);
            removeImage = false;
            setPreview(URL.createObjectURL(pendingFile));
            status.textContent = '';
          } catch {
            pendingFile = null;
            status.textContent =
              'No se pudo leer esa imagen. Prueba con JPG, PNG o WebP.';
          }
        });

        /** Resize phone photos to max 1400px and convert to WebP (~150–300 KB). */
        async function compressImage(file: File): Promise<Blob> {
          const bitmap = await createImageBitmap(file);
          const max = 1400;
          const scale = Math.min(1, max / Math.max(bitmap.width, bitmap.height));
          const w = Math.round(bitmap.width * scale);
          const h = Math.round(bitmap.height * scale);
          const canvas = document.createElement('canvas');
          canvas.width = w;
          canvas.height = h;
          canvas.getContext('2d')!.drawImage(bitmap, 0, 0, w, h);
          bitmap.close();
          const blob = await new Promise<Blob | null>((res) =>
            canvas.toBlob(res, 'image/webp', 0.82),
          );
          if (blob && blob.type === 'image/webp') return blob;
          // Safari < 17 can't encode WebP; fall back to JPEG.
          const jpeg = await new Promise<Blob | null>((res) =>
            canvas.toBlob(res, 'image/jpeg', 0.85),
          );
          if (!jpeg) throw new Error('encode failed');
          return jpeg;
        }

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const submit = $<HTMLButtonElement>('p-submit');
          submit.disabled = true;
          status.textContent = 'Guardando…';

          try {
            let image_path = editing?.image_path ?? null;
            const oldPath = image_path;

            if (pendingFile) {
              const ext = pendingFile.type === 'image/webp' ? 'webp' : 'jpg';
              const path = `products/${crypto.randomUUID()}.${ext}`;
              const { error } = await sb.storage
                .from(IMAGES_BUCKET)
                .upload(path, pendingFile, {
                  contentType: pendingFile.type,
                  cacheControl: '31536000',
                });
              if (error) throw error;
              image_path = path;
            } else if (removeImage) {
              image_path = null;
            }

            const record = {
              title: field('title').value.trim(),
              price: Number(field('price').value),
              category: field('category').value.trim(),
              description: field('description').value.trim() || null,
              in_stock: field<HTMLInputElement>('in_stock').checked,
              published: field<HTMLInputElement>('published').checked,
              image_path,
            };

            if (editing) {
              const { data, error } = await sb
                .from('products')
                .update(record)
                .eq('id', editing.id)
                .select()
                .single();
              if (error) throw error;
              products = products.map((p) => (p.id === editing!.id ? data : p));
            } else {
              const { data, error } = await sb
                .from('products')
                .insert(record)
                .select()
                .single();
              if (error) throw error;
              products = [data, ...products];
            }

            if (oldPath && oldPath !== image_path) {
              await sb.storage.from(IMAGES_BUCKET).remove([oldPath]);
            }

            const wasEditing = Boolean(editing);
            resetEditor();
            renderList();
            status.textContent = wasEditing
              ? '✓ Cambios guardados.'
              : '✓ Publicado. Ya aparece en el catálogo.';
          } catch (err) {
            status.textContent = `Error: ${(err as Error).message}`;
          } finally {
            submit.disabled = false;
          }
        });

        sb.auth.onAuthStateChange((event) => {
          if (event === 'SIGNED_OUT') show('login');
        });

        route();
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0d0d0f;
    --surface: #16161a;
    --surface-2: #1f1f25;
    --text: #f4f4f5;
    --muted: #a1a1aa;
    --border: #2c2c33;
    --accent: #ef4444;
    --accent-strong: #dc2626;
    color-scheme: dark;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: 'Inter', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  [hidden] {
    display: none !important;
  }

  code {
    padding: 0.05rem 0.3rem;
    background: var(--surface-2);
    font-size: 0.85em;
  }

  .adm-wrap {
    width: 100%;
    max-width: 76rem;
    margin: 0 auto;
    padding: 0 1rem;
    box-sizing: border-box;
  }

  .adm-top {
    border-bottom: 1px solid var(--border);
    margin-bottom: 1.5rem;
  }

  .adm-top-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 3.5rem;
  }

  .adm-brand {
    margin: 0;
    font-family: 'Bebas Neue', Impact, sans-serif;
    font-size: 1.5rem;
    letter-spacing: 0.04em;
  }

  .adm-brand span {
    color: var(--accent);
    font-family: 'Inter', sans-serif;
    font-weight: 900;
    font-size: 1rem;
  }

  .adm-brand small {
    margin-left: 0.3rem;
    padding: 0.1rem 0.35rem;
    background: var(--accent);
    color: #fff;
    font-family: 'Inter', sans-serif;
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    vertical-align: middle;
  }

  .adm-top-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.82rem;
  }

  .adm-top-actions a {
    color: var(--muted);
    text-decoration: none;
  }

  .adm-narrow {
    max-width: 26rem;
    margin: 3rem auto;
  }

  .adm-card {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 1.25rem;
  }

  .adm-h1 {
    margin: 0 0 1rem;
    font-family: 'Bebas Neue', Impact, sans-serif;
    font-weight: 400;
    font-size: 2rem;
    letter-spacing: 0.02em;
  }

  .adm-h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 800;
  }

  .adm-muted {
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .adm-error {
    margin: 0;
    color: var(--accent);
    font-size: 0.88rem;
  }

  .adm-form {
    display: grid;
    gap: 0.9rem;
  }

  .adm-field {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
  }

  .adm-field > span {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .adm-field input,
  .adm-field textarea,
  #list-search {
    width: 100%;
    box-sizing: border-box;
    padding: 0.6rem 0.7rem;
    background: var(--bg);
    color: var(--text);
    border: 1px solid var(--border);
    font: inherit;
    font-size: 0.95rem;
  }

  .adm-field textarea {
    resize: vertical;
  }

  .adm-field input:focus-visible,
  .adm-field textarea:focus-visible,
  #list-search:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .adm-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .adm-checks {
    grid-template-columns: auto auto;
    justify-content: start;
    gap: 1.25rem;
  }

  .adm-check {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
  }

  .adm-check input {
    accent-color: var(--accent);
    width: 1rem;
    height: 1rem;
  }

  .adm-btn,
  .adm-btn-ghost {
    padding: 0.7rem 1.1rem;
    border: 1px solid var(--accent);
    background: var(--accent);
    color: #fff;
    font: inherit;
    font-size: 0.88rem;
    font-weight: 800;
    cursor: pointer;
  }

  .adm-btn:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .adm-btn-ghost {
    background: transparent;
    border-color: var(--border);
    color: var(--text);
    font-weight: 600;
  }

  .adm-btn-sm {
    padding: 0.35rem 0.6rem;
    font-size: 0.75rem;
  }

  .adm-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .adm-grid {
    display: grid;
    gap: 1.5rem;
    padding-bottom: 4rem;
  }

  @media (min-width: 960px) {
    .adm-grid {
      grid-template-columns: 24rem 1fr;
      align-items: start;
    }

    .adm-editor {
      position: sticky;
      top: 1rem;
    }
  }

  .adm-photo {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }

  .adm-photo-drop {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 4 / 3;
    border: 1px dashed var(--border);
    background: var(--bg);
    color: var(--muted);
    font-size: 0.85rem;
    cursor: pointer;
    overflow: hidden;
  }

  .adm-photo-drop:hover {
    border-color: var(--accent);
  }

  .adm-photo-drop img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .adm-list-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
