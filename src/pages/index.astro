---
import { Image } from 'astro:assets';
import '../styles/global.css';
import logo from '../assets/brand/tansaku-logo.png';
import { WHATSAPP_NUMBER } from '../lib/shop';

const currentYear = new Date().getFullYear();
const INSTAGRAM_URL = 'https://www.instagram.com/tansakustore';

const wa = (text: string) =>
  `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(text)}`;

function shuffleArray<T>(array: T[]) {
  for (let i = array.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [array[i], array[j]] = [array[j], array[i]];
  }
  return array;
}

const coverModules = import.meta.glob(
  '../assets/covers/*.{jpg,jpeg,png,webp,avif}',
  {
    eager: true,
    import: 'default',
  },
) as Record<string, import('astro').ImageMetadata>;

const mangaMetaBySlug: Record<string, { title: string; genre: string }> = {
  akane: { title: 'Akane Banashi', genre: 'Drama / Shonen' },
  aonohako: { title: 'Ao no Hako', genre: 'Romance / Shonen' },
  csm: { title: 'Chainsaw Man', genre: 'Acción / Shonen' },
  dandadan: { title: 'Dandadan', genre: 'Acción / Seinen' },
  jujutsu: { title: 'Jujutsu Kaisen', genre: 'Acción / Shonen' },
  kagurabachi: { title: 'Kagurabachi', genre: 'Acción / Shonen' },
  madannoichi: { title: 'Madan no Ichi', genre: 'Fantasía / Shonen' },
  mushoku: { title: 'Mushoku Tensei', genre: 'Fantasía / Seinen' },
  onepiece: { title: 'One Piece', genre: 'Aventura / Shonen' },
  sakamoto: { title: 'Sakamoto Days', genre: 'Acción / Shonen' },
  spyfamily: { title: 'Spy x Family', genre: 'Comedia / Shonen' },
  witchwatch: { title: 'Witch Watch', genre: 'Comedia / Drama' },
  opm: { title: 'One Punch Man', genre: 'Acción / Comedia' },
  punpun: { title: 'Oyasumi Punpun', genre: 'Drama / Psicológico' },
  tokyoghoul: { title: 'Tokyo Ghoul', genre: 'Acción / Horror' },
  hxh: { title: 'Hunter x Hunter', genre: 'Acción / Aventura' },
  deathnote: { title: 'Death Note', genre: 'Drama / Misterio' },
  '100kano': {
    title: 'Kimi no Koto ga Dai Dai Dai Dai Daisuki na 100-nin no Kanojo',
    genre: 'Romance / Comedia',
  },
};

const catalogItems = Object.entries(coverModules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, image]) => {
    const fileName = path.split('/').pop() ?? '';
    const slug = fileName.split('.')[0]?.toLowerCase() ?? '';
    const meta = mangaMetaBySlug[slug] ?? {
      title: slug
        .replace(/[-_]/g, ' ')
        .replace(/\b\w/g, (char) => char.toUpperCase()),
      genre: 'Manga / Interés',
    };

    return { title: meta.title, genre: meta.genre, image };
  });

// Three random covers fanned out in the hero.
const heroCovers = shuffleArray([...catalogItems]).slice(0, 3);

// Starburst sticker shape (clip-path polygon).
const burst = (points = 14, inner = 0.82) =>
  Array.from({ length: points * 2 }, (_, i) => {
    const r = i % 2 ? inner : 1;
    const a = (Math.PI * i) / points;
    return `${(50 + 50 * r * Math.cos(a)).toFixed(2)}% ${(50 + 50 * r * Math.sin(a)).toFixed(2)}%`;
  }).join(',');
const burstShape = `polygon(${burst()})`;

const WA_ICON =
  'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z';

// Stroke icons (24×24, lucide-style paths).
const icons = {
