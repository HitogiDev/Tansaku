---
import { Image } from 'astro:assets';
import '../styles/global.css';
import logoDark from '../assets/logos/horizontal.png';
import logoLight from '../assets/logos/horizontal-claro.png';
import { WHATSAPP_NUMBER } from '../lib/shop';

const currentYear = new Date().getFullYear();
const INSTAGRAM_URL = 'https://www.instagram.com/tansakustore';

const wa = (text: string) =>
  `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(text)}`;

// Starburst sticker shape (clip-path polygon).
const burst = (points = 14, inner = 0.82) =>
  Array.from({ length: points * 2 }, (_, i) => {
    const r = i % 2 ? inner : 1;
    const a = (Math.PI * i) / points;
    return `${(50 + 50 * r * Math.cos(a)).toFixed(2)}% ${(50 + 50 * r * Math.sin(a)).toFixed(2)}%`;
  }).join(',');
const burstShape = `polygon(${burst()})`;

const WA_ICON =
  'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z';

// Stroke icons (24×24, lucide-style paths).
const icons = {
  arrow: '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
  bag: '<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>',
  poster:
    '<rect x="4" y="2" width="16" height="20" rx="1"/><circle cx="10" cy="8" r="2"/><path d="m20 16-4-4-8 8"/>',
  pin: '<circle cx="12" cy="10" r="7"/><path d="m9.5 10 1.8 1.8 3.4-3.6"/><path d="M12 17v5"/>',
  sticker:
    '<path d="M15.5 3H5a2 2 0 0 0-2 2v14c0 1.1.9 2 2 2h14a2 2 0 0 0 2-2V8.5L15.5 3Z"/><path d="M15 3v6h6"/><path d="M10 16s.8 1 2 1c1.3 0 2-1 2-1"/><path d="M8.5 11h.01"/><path d="M15.5 11h.01"/>',
  spark:
    '<path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>',
  bell: '<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>',
  mapPin:
    '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
  clock: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>',
  gift: '<path d="M20 12v10H4V12"/><rect width="20" height="5" x="2" y="7"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/>',
  check:
    '<path d="m9 11 3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>',
  lock: '<rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
  instagram:
    '<rect width="20" height="20" x="2" y="2" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><path d="M17.5 6.5h.01"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.93 4.93l2.12 2.12M16.95 16.95l2.12 2.12M4.93 19.07l2.12-2.12M16.95 7.05l2.12-2.12"/>',
  moon: '<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/>',
  plus: '<path d="M12 5v14"/><path d="M5 12h14"/>',
};

// Lo que hay hoy (guía de marca §01): pósters y stickers en stock; pines
// próximamente, sin fecha ni precio. Manga, figuras y ropa no se mencionan.
const merch = [
  {
    id: 'posters',
    kana: 'ポスター',
    icon: icons.poster,
    tone: 'red',
    stock: 'En stock',
    tag: '11x17',
    title: 'Pósters 11x17',
    desc: 'Tus series favoritas para tu pared. El tamaño de dos hojas de papel juntas.',
    priceNote: '1 póster',
    price: 'RD$100',
    combos: ['2 por RD$180', '3 por RD$250'],
    href: wa('Hola Tansaku, ¿me mandas el catálogo de pósters?'),
    cta: 'Ver pósters',
    soon: false,
  },
  {
    id: 'stickers',
    kana: 'ステッカー',
    icon: icons.sticker,
    tone: 'cyan',
    stock: 'En stock',
    tag: 'c/u',
    title: 'Stickers',
    desc: 'Para la laptop, el termo o donde quieras. Elige de tus series favoritas.',
    priceNote: 'Cada uno',
    price: 'RD$10',
    combos: [],
    href: wa('Hola Tansaku, ¿me mandas los stickers que tienes?'),
    cta: 'Ver stickers',
    soon: false,
  },
  {
    id: 'pines',
    kana: 'ピンズ',
    icon: icons.pin,
    tone: 'yellow',
    stock: 'Próximamente',
    tag: 'Pronto',
    title: 'Pines',
    desc: 'Próximamente. Cuando los tengamos en la mano, lo decimos en Instagram primero.',
    priceNote: '',
    price: '',
    combos: [],
    href: 'https://www.instagram.com/tansakustore',
    cta: 'Síguenos en Instagram',
    soon: true,
  },
];

const steps = [
  {
    num: '01',
    kana: 'メッセージ',
    title: 'Escríbenos',
    desc: 'Dinos qué te interesa por WhatsApp y te mandamos fotos, diseños y precios al momento.',
  },
  {
    num: '02',
    kana: 'デリバリー',
    title: 'Coordinamos la entrega',
    desc: 'Punto de encuentro en San Pedro de Macorís. La entrega es gratis y normalmente en 1 a 3 días.',
  },
  {
    num: '03',
    kana: 'ペイ',
    title: 'Pagas al recibir',
    desc: 'Revisas tu pedido en la mano y pagas como prefieras: efectivo, transferencia o tarjeta.',
  },
];

const tickerItems = [
  'Pósters 11x17',
  'Stickers RD$10',
  '3 pósters por RD$250',
  'Pagas al recibir',
  'Entrega gratis en San Pedro de Macorís',
  'Respuesta rápida',
  'Fans sirviendo fans',
];
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/tk.ico" />
    <title>Tansaku | Pósters y stickers de anime en San Pedro de Macorís</title>
    <meta
      name="description"
      content="Pósters de anime 11x17 desde RD$100 y stickers a RD$10 en San Pedro de Macorís. Entrega gratis en San Pedro y pagas al recibir."
    />
    <link rel="canonical" href="https://tansaku.site/" />
    <meta name="theme-color" content="#0b1118" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://tansaku.site/" />
    <meta property="og:site_name" content="Tansaku" />
    <meta property="og:locale" content="es_DO" />
    <meta property="og:title" content="Tansaku | Pósters y stickers de anime" />
    <meta
      property="og:description"
      content="Pósters 11x17 desde RD$100 y stickers a RD$10. Entrega gratis en San Pedro de Macorís y pagas al recibir."
    />
    <meta property="og:image" content="https://tansaku.site/og.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Tansaku — Pósters y stickers de anime en San Pedro de Macorís"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Tansaku | Pósters y stickers de anime" />
    <meta
      name="twitter:description"
      content="Pósters 11x17 desde RD$100 y stickers a RD$10 en San Pedro de Macorís. Pagas al recibir."
    />
    <meta name="twitter:image" content="https://tansaku.site/og.jpg" />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Store',
        name: 'Tansaku',
        alternateName: '探索',
        description:
          'Tienda otaku local de pósters y stickers de anime en San Pedro de Macorís, República Dominicana. Pagas al recibir.',
        url: 'https://tansaku.site/',
        image: 'https://tansaku.site/og.jpg',
        telephone: '+1-809-879-5559',
        sameAs: ['https://www.instagram.com/tansakustore'],
        priceRange: 'RD$10 - RD$250',
        currenciesAccepted: 'DOP',
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'San Pedro de Macorís',
          addressCountry: 'DO',
        },
        areaServed: [
          { '@type': 'City', name: 'San Pedro de Macorís' },
        ],
        makesOffer: [
          {
            '@type': 'Offer',
            itemOffered: { '@type': 'Product', name: 'Póster de anime 11x17' },
            priceCurrency: 'DOP',
            price: '100',
          },
          {
            '@type': 'Offer',
            itemOffered: { '@type': 'Product', name: 'Sticker de anime' },
            priceCurrency: 'DOP',
            price: '10',
          },
        ],
      })}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: '¿Cómo compro si no tienen tienda física?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'Todo pasa por WhatsApp: nos escribes, te mandamos fotos de lo disponible, eliges y coordinamos un punto de encuentro en San Pedro de Macorís. Ves tu pedido antes de pagar.',
            },
          },
          {
            '@type': 'Question',
            name: '¿Cómo pago?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'Efectivo, transferencia o tarjeta — siempre al momento de la entrega, con tu pedido en la mano, nunca por adelantado.',
            },
          },
          {
            '@type': 'Question',
            name: '¿Cuánto cuesta y cuánto tarda la entrega?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'La entrega es gratis en San Pedro de Macorís. Normalmente coordinamos en 1 a 3 días.',
            },
          },
          {
            '@type': 'Question',
            name: '¿Entregan en La Romana?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'Por ahora la entrega gratis es solo en San Pedro de Macorís. Si eso cambia, lo anunciamos aquí.',
            },
          },
          {
            '@type': 'Question',
            name: '¿Cuánto cuestan los pósters?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: '1 póster 11x17 RD$100, 2 por RD$180 y 3 por RD$250. Los stickers, RD$10 cada uno.',
            },
          },
          {
            '@type': 'Question',
            name: '¿Tienen manga?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'Todavía no vendemos manga. Hoy tenemos pósters y stickers; cuando eso cambie, lo anunciamos.',
            },
          },
          {
            '@type': 'Question',
            name: '¿Y si el producto no me convence?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'Lo revisas completo en la entrega, antes de pagar. Si no es lo que esperabas, no lo llevas y no pasa nada.',
            },
          },
        ],
      })}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700;9..40,800&family=Dela+Gothic+One&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Runs before paint: applies the saved theme and flags JS for reveals.
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        try {
          const t = localStorage.getItem('tansaku-theme');
          if (t === 'light' || t === 'dark') root.setAttribute('data-theme', t);
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a href="#merch" class="skip-link">Saltar al contenido</a>

    <header class="nav">
      <div class="wrap nav-inner">
        <a href="/" class="brand" aria-label="Tansaku — inicio">
          <Image src={logoDark} alt="Tansaku" class="brand-logo brand-logo-dark" widths={[128, 256]} sizes="128px" format="webp" loading="eager" />
          <Image src={logoLight} alt="Tansaku" class="brand-logo brand-logo-light" widths={[128, 256]} sizes="128px" format="webp" loading="eager" />
        </a>
        <nav class="nav-links" aria-label="Secciones">
          <a href="#merch">Merch</a>
          <a href="#nosotros">Nosotros</a>
          <a href="#faq">FAQ</a>
          <a href="#contacto">Pide tu serie</a>
        </nav>
        <div class="nav-actions">
          <button
            id="theme-toggle"
            type="button"
            class="theme-toggle"
            aria-label="Cambiar tema"
          >
            <span id="theme-icon-sun" class="theme-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons.sun} />
            </span>
            <span id="theme-icon-moon" class="theme-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons.moon} />
            </span>
            <span id="theme-toggle-label" class="sr-only">Modo claro</span>
          </button>
          <a href="/catalogo/" class="btn btn-primary btn-sm" id="nav-btn-catalogo">
            Catálogo
          </a>
        </div>
      </div>
    </header>

    <main>
      <!-- ══ HERO ═════════════════════════════════════════════════ -->
      <section class="hero">
        <div class="hero-bg" aria-hidden="true">
          <div class="hero-lines"></div>
          <div class="hero-dots"></div>
          <span class="hero-kanji">探索</span>
        </div>

        <div class="wrap hero-inner">
          <div class="hero-copy">
            <h1 class="hero-title">
              <span class="hero-title-line">Pósters y</span>
              <span class="hero-title-line">stickers</span>
              <span class="hero-title-line hero-title-accent">de anime</span>
              <span class="hero-title-place">
                en <b>San Pedro de Macorís</b>
              </span>
            </h1>
            <p class="hero-lead">
              Somos fans igual que tú. Pósters 11x17 desde
              <strong class="hl-text">RD$100</strong> y stickers a
              <strong class="hl-text">RD$10</strong>. Entrega gratis en San
              Pedro de Macorís y <strong>pagas al recibir.</strong>
            </p>
            <div class="hero-cta-row">
              <a href="#merch" id="hero-cta-main" class="btn btn-primary">
                <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.bag} />
                Ver precios
              </a>
              <a href="/catalogo/" id="hero-cta-secondary" class="btn btn-ghost">
                Ver catálogo
                <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.arrow} />
              </a>
            </div>
          </div>

          <div class="hero-art">
            <div class="board">
              <div class="board-card">
                <p class="board-head">
                  <span>Pósters 11x17</span>
                </p>
                <ul class="board-rows">
                  <li><span>1 póster</span><b>RD$100</b></li>
                  <li><span>2 pósters</span><b>RD$180</b></li>
                  <li class="board-row-best"><span>3 pósters</span><b>RD$250</b></li>
                </ul>
                <p class="board-foot">Stickers a <b>RD$10</b> c/u</p>
              </div>
              <span class="sticker sticker-burst" style={`clip-path:${burstShape}`} aria-hidden="true">
                <span>Entrega<br /><b>GRATIS</b></span>
              </span>
              <span class="sticker sticker-stamp">Pagas al recibir</span>
            </div>
          </div>

          <ul class="hero-trust">
            <li>
              <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.bag} />
              <span>Pósters y stickers en stock</span>
            </li>
            <li>
              <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.check} />
              <span>Pagas al recibir</span>
            </li>
            <li>
              <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.mapPin} />
              <span>Entrega gratis en San Pedro de Macorís</span>
            </li>
          </ul>
        </div>
      </section>

      <!-- ══ TICKER ═══════════════════════════════════════════════ -->
      <div class="ticker" aria-hidden="true">
        <div class="ticker-track">
          {
            [0, 1].map(() => (
              <div class="ticker-group">
                {tickerItems.map((item) => (
                  <span class="ticker-item">
                    {item}
                    <span class="ticker-star">★</span>
                  </span>
                ))}
              </div>
            ))
          }
        </div>
      </div>

      <!-- ══ MERCH ════════════════════════════════════════════════ -->
      <section id="merch" class="section merch-section">
        <div class="wrap">
          <header class="sec-head reveal">
            <p class="eyebrow"><span class="eyebrow-num">01</span> Disponible ya <span class="eyebrow-jp">グッズ</span></p>
            <h2 class="sec-title">Compra <span class="hl">hoy mismo</span></h2>
            <p class="sec-lead">
              Pósters y stickers en stock hoy. Pide por WhatsApp, entrega gratis
              en San Pedro de Macorís y pagas al recibir.
            </p>
          </header>

          <div class="merch-grid">
            {
              merch.map((item) => (
                <article
                  class={`merch-card tone-${item.tone} reveal`}
                  id={`merch-${item.id}`}
                >
                  <div class="merch-visual" aria-hidden="true">
                    <span class="merch-kana">{item.kana}</span>
                    <span class="merch-icon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
                    </span>
                  </div>
                  <div class="merch-body">
                    <div class="merch-tags">
                      <span class={`tag ${item.soon ? 'tag-soon' : 'tag-stock'}`}>
                        {item.stock}
                      </span>
                      <span class="tag tag-plain">{item.tag}</span>
                    </div>
                    <h3 class="merch-title">{item.title}</h3>
                    <p class="merch-desc">{item.desc}</p>
                    {item.price ? (
                      <p class="merch-price">
                        <span class="merch-price-note">{item.priceNote}</span>
                        <span class="merch-price-value">{item.price}</span>
                        {item.combos.map((combo) => (
                          <span class="merch-price-combo">{combo}</span>
                        ))}
                      </p>
                    ) : (
                      <p class="merch-price">
                        <span class="merch-price-value merch-price-soon">Próximamente</span>
                      </p>
                    )}
                    <a
                      href={item.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class={`btn btn-block ${item.soon ? 'btn-ghost' : 'btn-wa'}`}
                      id={`merch-btn-${item.id}`}
                    >
                      {item.soon ? (
                        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.instagram} />
                      ) : (
                        <svg class="ico" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={WA_ICON} /></svg>
                      )}
                      <span>{item.cta}{!item.soon && <span class="btn-extra"> por WhatsApp</span>}</span>
                    </a>
                  </div>
                </article>
              ))
            }
          </div>

          <div class="center-row reveal">
            <a href="/catalogo/" class="btn btn-primary" id="merch-btn-catalogo">
              Ver catálogo completo
              <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.arrow} />
            </a>
          </div>

          <div class="how" id="como-comprar">
            <h3 class="how-title reveal">¿Cómo <span class="hl-red">comprar?</span></h3>
            <ol class="how-steps">
              {
