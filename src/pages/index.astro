---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/tk.ico" />
    <title>Tansaku | Manga, Posters y Mercancía Anime en San Pedro y La Romana</title>
    <meta
      name="description"
      content="Tansaku es tu tienda de manga físico, posters, pines, stickers y mercancía anime en San Pedro de Macorís y La Romana. Compra ya o únete a la lista fundadora."
    />
    <link rel="canonical" href="https://tansaku.site/" />
    <meta name="theme-color" content="#0b0a0d" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://tansaku.site/" />
    <meta property="og:site_name" content="Tansaku" />
    <meta property="og:locale" content="es_DO" />
    <meta property="og:title" content="Tansaku | Manga y Merch Anime en RD" />
    <meta
      property="og:description"
      content="Manga, posters y mercancía anime llegan a San Pedro y La Romana. Compra posters, pines y stickers ya mismo."
    />
    <meta property="og:image" content="https://tansaku.site/og.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Tansaku — Manga, posters y merch anime en San Pedro de Macorís y La Romana"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Tansaku | Manga y Merch Anime en RD" />
    <meta
      name="twitter:description"
      content="Manga, posters y mercancía anime en San Pedro de Macorís y La Romana. Posters, pines y stickers disponibles ya."
    />
    <meta name="twitter:image" content="https://tansaku.site/og.jpg" />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Store',
        name: 'Tansaku',
        alternateName: '探索',
        description:
          'Tienda de manga físico, posters, pines, stickers y mercancía anime en San Pedro de Macorís y La Romana, República Dominicana.',
        url: 'https://tansaku.site/',
        image: 'https://tansaku.site/og.jpg',
        telephone: '+1-809-879-5559',
        sameAs: ['https://www.instagram.com/tansakustore'],
        priceRange: 'RD$10 - RD$1000',
        currenciesAccepted: 'DOP',
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'San Pedro de Macorís',
          addressCountry: 'DO',
        },
        areaServed: [
          { '@type': 'City', name: 'San Pedro de Macorís' },
          { '@type': 'City', name: 'La Romana' },
        ],
        makesOffer: [
          {
            '@type': 'Offer',
            itemOffered: { '@type': 'Product', name: 'Posters anime' },
          },
          {
            '@type': 'Offer',
            itemOffered: { '@type': 'Product', name: 'Pines metálicos anime' },
            priceCurrency: 'DOP',
            price: '150',
          },
          {
            '@type': 'Offer',
            itemOffered: { '@type': 'Product', name: 'Stickers anime' },
            priceCurrency: 'DOP',
            price: '10',
          },
        ],
      })}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: '¿Cómo compro si no tienen tienda física?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'Todo pasa por WhatsApp: nos escribes, te mandamos fotos de lo disponible, eliges y coordinamos un punto de encuentro en San Pedro de Macorís o La Romana. Ves tu pedido antes de pagar.',
            },
          },
          {
            '@type': 'Question',
            name: '¿Cómo pago?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'Efectivo, transferencia o tarjeta — siempre al momento de la entrega, con tu pedido en la mano, nunca por adelantado.',
            },
          },
          {
            '@type': 'Question',
            name: '¿Cuánto cuesta y cuánto tarda la entrega?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'La entrega es gratis en San Pedro de Macorís y La Romana. Normalmente coordinamos en 1 a 3 días.',
            },
          },
          {
            '@type': 'Question',
            name: '¿Y si el producto no me convence?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'Lo revisas completo en la entrega, antes de pagar. Si no es lo que esperabas, no lo llevas y no pasa nada.',
            },
          },
        ],
      })}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700;9..40,800&family=Dela+Gothic+One&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Runs before paint: applies the saved theme and flags JS for reveals.
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        try {
          const t = localStorage.getItem('tansaku-theme');
          if (t === 'light' || t === 'dark') root.setAttribute('data-theme', t);
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a href="#merch" class="skip-link">Saltar al contenido</a>

    <header class="nav">
      <div class="wrap nav-inner">
        <a href="/" class="brand" aria-label="Tansaku — inicio">
          <Image src={logo} alt="" class="brand-logo" widths={[48, 96]} sizes="40px" format="webp" loading="eager" aria-hidden="true" />
          <span class="brand-name">Tansaku</span>
        </a>
        <nav class="nav-links" aria-label="Secciones">
          <a href="#merch">Merch</a>
          <a href="#catalogo">Manga</a>
          <a href="#nosotros">Nosotros</a>
          <a href="#faq">FAQ</a>
          <a href="#contacto">Vota</a>
        </nav>
        <div class="nav-actions">
          <button
            id="theme-toggle"
            type="button"
            class="theme-toggle"
            aria-label="Cambiar tema"
          >
            <span id="theme-icon-sun" class="theme-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons.sun} />
            </span>
            <span id="theme-icon-moon" class="theme-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons.moon} />
            </span>
            <span id="theme-toggle-label" class="sr-only">Modo claro</span>
          </button>
          <a href="/catalogo/" class="btn btn-primary btn-sm" id="nav-btn-catalogo">
            Catálogo
          </a>
        </div>
      </div>
    </header>

    <main>
      <!-- ══ HERO ═════════════════════════════════════════════════ -->
      <section class="hero">
        <div class="hero-bg" aria-hidden="true">
          <div class="hero-lines"></div>
          <div class="hero-dots"></div>
          <span class="hero-kanji">探索</span>
        </div>

        <div class="wrap hero-inner">
          <div class="hero-copy">
            <div class="hero-brand">
              <Image src={logo} alt="Logo de Tansaku" class="hero-logo" widths={[128, 256]} sizes="88px" format="webp" loading="eager" />
              <p class="hero-brand-text">
                <b>Tansaku</b>
                <span>探索 · Tienda otaku RD</span>
              </p>
            </div>
            <h1 class="hero-title">
              <span class="hero-title-line">Manga,</span>
              <span class="hero-title-line">posters y</span>
              <span class="hero-title-line hero-title-accent">merch anime</span>
              <span class="hero-title-place">
                en <b>San Pedro</b> y <b>La Romana</b>
              </span>
            </h1>
            <p class="hero-lead">
              Tu tienda otaku en
              <strong>San Pedro de Macorís y La Romana.</strong>
              Compra <strong class="hl-text">posters, pines y stickers</strong>
              ya mismo. ¡Y el manga físico llega pronto!
            </p>
            <div class="hero-cta-row">
              <a href="#merch" id="hero-cta-main" class="btn btn-primary">
                <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.bag} />
                Comprar ahora
              </a>
              <a href="/catalogo/" id="hero-cta-secondary" class="btn btn-ghost">
                Ver catálogo
                <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.arrow} />
              </a>
            </div>
          </div>

          <div class="hero-art" aria-hidden="true">
            <div class="fan">
              {
                heroCovers.map((cover, i) => (
                  <div class={`fan-card fan-card-${i + 1}`}>
                    <Image
                      src={cover.image}
                      alt=""
                      loading="eager"
                      fetchpriority={i === 1 ? 'high' : 'auto'}
                      widths={[200, 320, 440]}
                      sizes="(max-width: 899px) 36vw, 220px"
                      format="webp"
                      quality={76}
                    />
                  </div>
                ))
              }
              <span class="sticker sticker-burst" style={`clip-path:${burstShape}`}>
                <span>Entrega<br /><b>GRATIS</b></span>
              </span>
              <span class="sticker sticker-stamp">Pagas al recibir</span>
              <span class="sticker sticker-logo">
                <Image src={logo} alt="" widths={[160, 320]} sizes="(max-width: 899px) 26vw, 150px" format="webp" loading="eager" />
              </span>
            </div>
          </div>

          <ul class="hero-trust">
            <li>
              <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.bag} />
              <span>Merch disponible ya</span>
            </li>
            <li>
              <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.check} />
              <span>Pagas al recibir</span>
            </li>
            <li>
              <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.spark} />
              <span>+15 series de manga</span>
            </li>
          </ul>
        </div>
      </section>

      <!-- ══ TICKER ═══════════════════════════════════════════════ -->
      <div class="ticker" aria-hidden="true">
        <div class="ticker-track">
          {
            [0, 1].map(() => (
              <div class="ticker-group">
                {tickerItems.map((item) => (
                  <span class="ticker-item">
                    {item}
                    <span class="ticker-star">★</span>
                  </span>
                ))}
              </div>
            ))
          }
        </div>
      </div>

      <!-- ══ MERCH ════════════════════════════════════════════════ -->
      <section id="merch" class="section merch-section">
        <div class="wrap">
          <header class="sec-head reveal">
            <p class="eyebrow"><span class="eyebrow-num">01</span> Disponible ya <span class="eyebrow-jp">グッズ</span></p>
            <h2 class="sec-title">Compra <span class="hl">hoy mismo</span></h2>
