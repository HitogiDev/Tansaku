    color-scheme: light;
  }

  /* ── Base ───────────────────────────────────────────────────── */
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 4.5rem;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  main {
    overflow-x: clip;
  }

  ::selection {
    background: var(--yellow);
    color: var(--ink);
  }

  :focus-visible {
    outline: 3px solid var(--yellow);
    outline-offset: 3px;
  }

  .wrap {
    width: 100%;
    max-width: 76rem;
    margin-inline: auto;
    padding-inline: 1rem;
  }

  .ico {
    width: 1.05em;
    height: 1.05em;
    flex: none;
  }

  .skip-link {
    position: absolute;
    left: 0.75rem;
    top: -4rem;
    z-index: 100;
    background: var(--yellow);
    color: var(--ink);
    font-weight: 800;
    padding: 0.6rem 0.9rem;
    border: 2px solid var(--ink);
  }

  .skip-link:focus {
    top: 0.75rem;
  }

  /* ── Buttons ────────────────────────────────────────────────── */
  .btn {
    --btn-bg: transparent;
    --btn-fg: var(--text);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 3rem;
    padding: 0.7rem 1.15rem;
    border: 2px solid var(--stroke);
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-family: var(--font-body);
    font-size: 0.86rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    line-height: 1.1;
    text-transform: uppercase;
    text-decoration: none;
    text-align: center;
    cursor: pointer;
    box-shadow: 4px 4px 0 var(--shadow);
    transition:
      transform 140ms ease,
      box-shadow 140ms ease,
      background-color 140ms ease;
  }

  .btn:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--shadow);
  }

  .btn:active {
    transform: translate(3px, 3px);
    box-shadow: 1px 1px 0 var(--shadow);
  }

  .btn-primary {
    --btn-bg: var(--yellow);
    --btn-fg: var(--ink);
    border-color: var(--ink);
  }

  .btn-wa {
    --btn-bg: var(--wa);
    --btn-fg: var(--ink);
    border-color: var(--ink);
  }

  .btn-ghost {
    --btn-bg: var(--bg);
  }

  .btn-sm {
    min-height: 2.5rem;
    padding: 0.45rem 0.8rem;
    font-size: 0.74rem;
    box-shadow: 3px 3px 0 var(--shadow);
  }

  .btn-lg {
    min-height: 3.5rem;
    font-size: 0.95rem;
  }

  .btn-block {
    width: 100%;
  }

  /* ── Nav ────────────────────────────────────────────────────── */
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 2px solid var(--stroke);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.75rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--text);
  }

  .brand-logo {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 2px solid var(--stroke);
    transform: rotate(-6deg);
    transition: transform 220ms ease;
  }

  .brand:hover .brand-logo {
    transform: rotate(6deg) scale(1.06);
  }

  .footer-logo {
    width: 4.5rem;
    height: 4.5rem;
    margin-bottom: 0.75rem;
    border-radius: 50%;
    border: 2px solid var(--stroke);
    box-shadow: 4px 4px 0 var(--shadow);
    transform: rotate(-6deg);
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1;
  }

  .nav-links {
    display: none;
    gap: 1.6rem;
  }

  .nav-links a {
    position: relative;
    color: var(--text);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    padding-block: 0.4rem;
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: var(--red);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 180ms ease;
  }

  .nav-links a:hover::after {
    transform: scaleX(1);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 2px solid var(--stroke);
    background: var(--bg);
    color: var(--text);
    cursor: pointer;
    transition:
      background-color 140ms ease,
      color 140ms ease;
  }

  .theme-toggle:hover {
    background: var(--text);
    color: var(--bg);
  }

  .theme-icon {
    display: grid;
    width: 1.15rem;
    height: 1.15rem;
  }

  .theme-icon[hidden] {
    display: none;
  }

  /* ── Hero ───────────────────────────────────────────────────── */
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .hero-lines {
    position: absolute;
    inset: -30%;
    background: repeating-conic-gradient(
      from 0deg at 72% 46%,
      var(--dot) 0deg 0.45deg,
      transparent 0.45deg 4deg
    );
    -webkit-mask-image: radial-gradient(
      circle at 72% 46%,
      transparent 0 16%,
      #000 62%
    );
    mask-image: radial-gradient(circle at 72% 46%, transparent 0 16%, #000 62%);
    opacity: 0.75;
  }

  .hero-dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--red) 1.6px, transparent 2px);
    background-size: 11px 11px;
    -webkit-mask-image: linear-gradient(
      200deg,
      #000 0%,
      transparent 34%,
      transparent 100%
    );
    mask-image: linear-gradient(200deg, #000 0%, transparent 34%, transparent 100%);
    opacity: 0.55;
  }

  .hero-kanji {
    position: absolute;
    right: -0.08em;
    bottom: -0.2em;
    font-family: var(--font-display);
    font-size: clamp(11rem, 44vw, 30rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 2px var(--hair);
    writing-mode: vertical-rl;
    user-select: none;
  }

  .hero-inner {
    display: grid;
    gap: 2rem;
    padding-block: 2.25rem 2.5rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.38rem 0.7rem;
    border: 2px solid var(--stroke);
    background: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .chip-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--wa);
    box-shadow: 0 0 0 0 var(--wa);
    animation: pulse 1.8s ease-out infinite;
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgb(37 211 102 / 0.7);
    }
    100% {
      box-shadow: 0 0 0 0.6rem rgb(37 211 102 / 0);
    }
  }

  .hero-title {
    margin: 1.1rem 0 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.2rem, 10.6vw, 5.4rem);
    line-height: 1.02;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .hero-title-line {
    display: block;
  }

  .hero-title-accent {
    color: var(--red);
  }

  .hero-title-place {
    display: inline-block;
    margin-top: 0.85rem;
    padding: 0.45em 0.7em 0.5em;
    background: var(--yellow);
    color: var(--ink);
    border: 2px solid var(--ink);
    font-size: clamp(0.82rem, 3.7vw, 1.35rem);
    line-height: 1.1;
    letter-spacing: 0.01em;
    transform: rotate(-2deg);
    box-shadow: 4px 4px 0 var(--shadow);
  }

  .hero-title-place b {
    font-weight: 400;
  }

  .hero-lead {
    margin: 1.5rem 0 0;
    max-width: 34rem;
    font-size: 1.02rem;
    color: var(--muted);
  }

  .hero-lead strong {
    color: var(--text);
    font-weight: 700;
  }

  .hero-lead .hl-text {
    background: linear-gradient(transparent 62%, color-mix(in srgb, var(--red) 55%, transparent) 62%);
  }

  .hero-cta-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem;
    margin-top: 1.6rem;
  }

  .hero-cta-row .btn {
    padding-inline: 0.6rem;
  }

  /* Fanned covers */
  .hero-art {
    position: relative;
  }

  .fan {
    position: relative;
    width: min(100%, 24rem);
    margin-inline: auto;
    aspect-ratio: 10 / 7.4;
  }

  .fan-card {
    position: absolute;
    top: 6%;
    width: 40%;
    aspect-ratio: 2 / 3;
    border: 2px solid var(--stroke);
    background: var(--surface);
    box-shadow: 5px 5px 0 var(--shadow);
    overflow: hidden;
    transition: transform 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .fan-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fan-card-1 {
    left: 4%;
    transform: rotate(-11deg) translateY(6%);
  }

  .fan-card-2 {
    left: 30%;
    z-index: 2;
    transform: rotate(-1deg);
  }

  .fan-card-3 {
    left: 56%;
    transform: rotate(10deg) translateY(7%);
  }

  .fan:hover .fan-card-1 {
    transform: rotate(-15deg) translate(-8%, 4%);
  }

  .fan:hover .fan-card-2 {
    transform: rotate(-1deg) translateY(-4%);
  }

  .fan:hover .fan-card-3 {
    transform: rotate(14deg) translate(8%, 5%);
  }

  .sticker {
    position: absolute;
    z-index: 3;
    font-family: var(--font-display);
    text-transform: uppercase;
    line-height: 1;
  }

  .sticker-burst {
    right: -2%;
    top: -6%;
    display: grid;
    place-items: center;
    width: 31%;
    aspect-ratio: 1;
    background: var(--yellow);
    color: var(--ink);
    text-align: center;
    font-size: clamp(0.56rem, 2.5vw, 0.78rem);
    transform: rotate(12deg);
    animation: wobble 5s ease-in-out infinite;
  }

  .sticker-burst b {
    display: block;
    margin-top: 0.15em;
    font-weight: 400;
    font-size: 1.35em;
    color: var(--red);
  }

  html[data-theme='dark'] .sticker-burst b {
    color: #e0162b;
  }

  .sticker-stamp {
    left: -1%;
    bottom: 2%;
    padding: 0.5em 0.75em;
    border: 2px solid var(--ink);
    background: var(--red);
    color: #fff;
    font-size: clamp(0.62rem, 2.8vw, 0.82rem);
    letter-spacing: 0.04em;
    transform: rotate(-6deg);
    box-shadow: 3px 3px 0 var(--ink);
  }

  html[data-theme='dark'] .sticker-stamp {
    box-shadow: 3px 3px 0 var(--paper);
  }

  .sticker-logo {
    right: -3%;
    bottom: -4%;
    width: 27%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 3px solid var(--ink);
    box-shadow: 4px 4px 0 var(--ink);
    transform: rotate(8deg);
    animation: spin-slow 14s ease-in-out infinite;
  }

  html[data-theme='dark'] .sticker-logo {
    border-color: var(--paper);
    box-shadow: 4px 4px 0 var(--paper);
  }

  .sticker-logo img {
    width: 100%;
    height: 100%;
    display: block;
    border-radius: 50%;
  }

  @keyframes spin-slow {
    0%,
    100% {
      transform: rotate(8deg);
    }
    50% {
      transform: rotate(-6deg) scale(1.04);
    }
  }

  .hero-brand {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.1rem;
  }

  .hero-logo {
    width: 4.25rem;
    height: 4.25rem;
    flex: none;
    border-radius: 50%;
    border: 2px solid var(--stroke);
    box-shadow: 4px 4px 0 var(--shadow);
    transform: rotate(-8deg);
  }

  .hero-brand-text {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    line-height: 1;
  }

  .hero-brand-text b {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.5rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .hero-brand-text span {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted, currentColor);
  }

  @keyframes wobble {
    0%,
    100% {
      transform: rotate(12deg) scale(1);
    }
    50% {
      transform: rotate(4deg) scale(1.06);
    }
  }

  .hero-trust {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
    border: 2px solid var(--stroke);
    background: var(--bg);
  }

  .hero-trust li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding: 0.8rem 0.4rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.2;
    text-align: center;
    text-transform: uppercase;
  }

  .hero-trust li + li {
    border-left: 2px solid var(--stroke);
  }

  .hero-trust .ico {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--red);
  }

  /* ── Ticker ─────────────────────────────────────────────────── */
  .ticker {
    position: relative;
    z-index: 2;
    width: 104%;
    margin: 0.4rem -2% 0;
    overflow: hidden;
    background: var(--yellow);
    color: var(--ink);
    border-block: 2px solid var(--ink);
    transform: rotate(-1.2deg);
  }

  .ticker-track {
    display: flex;
    width: max-content;
    animation: ticker 32s linear infinite;
  }

  .ticker-group {
    display: flex;
    flex: none;
  }

  .ticker-item {
    display: inline-flex;
    align-items: center;
    gap: 1.1rem;
    padding: 0.6rem 0 0.7rem 1.1rem;
    font-family: var(--font-display);
    font-size: 0.95rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .ticker-star {
    color: #e0162b;
  }

  @keyframes ticker {
    to {
      transform: translateX(-50%);
    }
  }

  /* ── Sections ───────────────────────────────────────────────── */
  .section {
    position: relative;
    padding-block: 4rem;
  }

  .sec-head {
    max-width: 44rem;
    margin-bottom: 2rem;
  }

  .eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .eyebrow-num {
    padding: 0.15rem 0.45rem;
    background: var(--red);
    color: #fff;
    font-weight: 500;
  }

  html[data-theme='dark'] .eyebrow-num {
    color: var(--ink);
  }

  .eyebrow-jp {
    font-family: var(--font-display);
    letter-spacing: 0.05em;
    color: var(--red);
  }

  .sec-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.9rem, 8.4vw, 3.6rem);
    line-height: 1.12;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .hl {
    display: inline-block;
    padding: 0 0.22em 0.06em;
    background: var(--yellow);
    color: var(--ink);
    transform: rotate(-1.5deg);
  }

  .hl-red {
    color: var(--red);
  }

  .sec-lead {
    margin: 1.1rem 0 0;
    max-width: 38rem;
    color: var(--muted);
    font-size: 1rem;
  }

  .sec-lead strong {
    color: var(--text);
  }

  .center-row {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }

  /* ── Merch ──────────────────────────────────────────────────── */
  .merch-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .merch-card {
    --tone: var(--red);
    --tone-fg: #fff;
    display: flex;
    flex-direction: column;
    border: 2px solid var(--stroke);
    background: var(--surface);
    box-shadow: 4px 4px 0 var(--shadow);
    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .merch-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 8px 8px 0 var(--shadow);
  }

  .tone-yellow {
    --tone: var(--yellow);
    --tone-fg: var(--ink);
  }

  .tone-cyan {
    --tone: var(--cyan);
    --tone-fg: var(--ink);
  }

  .tone-paper {
    --tone: var(--bg-alt);
    --tone-fg: var(--text);
  }

  .merch-visual {
    position: relative;
    display: grid;
    place-items: center;
    height: 6.5rem;
    overflow: hidden;
    background: var(--tone);
    color: var(--tone-fg);
    border-bottom: 2px solid var(--stroke);
  }

  .merch-visual::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(currentColor 1.3px, transparent 1.7px);
    background-size: 9px 9px;
    opacity: 0.22;
    -webkit-mask-image: linear-gradient(120deg, transparent 30%, #000);
    mask-image: linear-gradient(120deg, transparent 30%, #000);
  }

  .merch-kana {
    position: absolute;
    left: 0.5rem;
    bottom: -0.12em;
    font-family: var(--font-display);
    font-size: 2.6rem;
    line-height: 1;
    white-space: nowrap;
    opacity: 0.22;
  }

  .merch-icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 3.4rem;
    height: 3.4rem;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
    transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .merch-icon svg {
    width: 1.75rem;
    height: 1.75rem;
  }

  .merch-card:hover .merch-icon {
    transform: rotate(-10deg) scale(1.1);
  }

  .merch-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 0.8rem;
  }

  .merch-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tag {
    padding: 0.18rem 0.42rem;
    border: 1.5px solid var(--stroke);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .tag-stock {
    background: var(--wa);
    border-color: var(--ink);
    color: var(--ink);
  }

  .tag-soon {
    background: var(--red);
    border-color: var(--ink);
    color: #fff;
  }

  .tag-plain {
    display: none;
    color: var(--muted);
    border-color: var(--hair);
  }

  .merch-title {
    margin: 0.7rem 0 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1rem;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .merch-desc {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.45;
  }

  .merch-price {
    display: flex;
    flex-direction: column;
    margin: auto 0 0;
    padding-block: 0.85rem;
  }

  .merch-price-note {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .merch-price-value {
    font-family: var(--font-display);
    font-size: 1.1rem;
    line-height: 1.25;
    color: var(--yellow);
  }

  html[data-theme='light'] .merch-price-value {
    color: var(--red);
  }

  .merch-body .btn {
    min-height: 2.75rem;
    padding-inline: 0.5rem;
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    box-shadow: 3px 3px 0 var(--shadow);
  }

  .btn-extra {
    display: none;
  }

  /* ── Cómo comprar ───────────────────────────────────────────── */
  .how {
    margin-top: 4rem;
  }

  .how-title {
    margin: 0 0 1.5rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.6rem, 7vw, 2.6rem);
    line-height: 1.1;
    text-transform: uppercase;
  }

  .how-steps {
    display: grid;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .how-step {
    position: relative;
    overflow: hidden;
    padding: 1.2rem 1.1rem 1.3rem 5.2rem;
    border: 2px solid var(--stroke);
    background: var(--surface);
  }

  .how-step::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    width: 7rem;
    height: 7rem;
    background-image: radial-gradient(var(--dot) 1.4px, transparent 1.8px);
    background-size: 8px 8px;
    -webkit-mask-image: linear-gradient(315deg, #000, transparent 70%);
    mask-image: linear-gradient(315deg, #000, transparent 70%);
    pointer-events: none;
  }

  .how-num {
    position: absolute;
    left: 0.9rem;
    top: 0.85rem;
    font-family: var(--font-display);
    font-size: 2.6rem;
    line-height: 1;
    color: var(--red);
  }

  .how-kana {
    display: block;
    font-family: var(--font-display);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    color: var(--muted);
  }

  .how-heading {
    margin: 0.2rem 0 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.05rem;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .how-desc {
    margin: 0.45rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .how-note {
    margin: 1.4rem 0 0;
    padding: 0.85rem 1rem;
    border: 2px dashed var(--stroke);
    font-size: 0.9rem;
    color: var(--muted);
  }

  .how-note b {
    color: var(--text);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* ── Manga ──────────────────────────────────────────────────── */
  .manga-section {
    background: var(--bg-alt);
    border-block: 2px solid var(--stroke);
    background-image: radial-gradient(var(--dot) 1.2px, transparent 1.6px);
    background-size: 14px 14px;
  }

  .catalog-preview-item {
    display: none;
  }

  .catalog-preview-item.is-active {
    display: flex;
  }

  .manga-rail-wrap {
    width: 100%;
    max-width: 76rem;
    margin-inline: auto;
  }

  .manga-rail {
    display: flex;
    gap: 1rem;
    padding: 0.4rem 1rem 1.2rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 1rem;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .manga-rail::-webkit-scrollbar {
    display: none;
  }

  .manga-card {
    flex: none;
    flex-direction: column;
    width: 40vw;
    max-width: 13rem;
    scroll-snap-align: start;
  }

  .manga-cover {
    position: relative;
    display: block;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border: 2px solid var(--stroke);
    background: var(--surface);
    box-shadow: 4px 4px 0 var(--shadow);
    transition:
      transform 200ms ease,
      box-shadow 200ms ease;
  }

  .manga-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  .manga-card:nth-child(odd) .manga-cover {
    transform: rotate(-1.2deg);
  }

  .manga-card:nth-child(even) .manga-cover {
    transform: rotate(1.2deg);
  }

  .manga-card .manga-cover:hover {
    transform: rotate(0) translate(-3px, -3px);
    box-shadow: 8px 8px 0 var(--shadow);
  }

  .manga-cover:hover img {
    transform: scale(1.05);
  }

  .manga-bell {
    position: absolute;
    left: 0;
    bottom: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.55rem;
    background: var(--yellow);
    color: var(--ink);
    border-top: 2px solid var(--ink);
    border-right: 2px solid var(--ink);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .manga-meta {
    padding-top: 0.85rem;
  }

  .manga-genre {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--red);
  }

  .manga-title {
    display: -webkit-box;
    margin: 0.2rem 0 0;
    overflow: hidden;
    font-size: 0.92rem;
    font-weight: 800;
    line-height: 1.25;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  .manga-note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin: 0.8rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .manga-note-swipe {
    padding: 0.2rem 0.5rem;
    background: var(--text);
    color: var(--bg);
  }

  /* ── Nosotros ───────────────────────────────────────────────── */
  .about-inner {
    display: grid;
    gap: 2.5rem;
  }

  .bubble {
    position: relative;
    margin-top: 1.6rem;
    padding: 1.15rem 1.2rem;
    border: 2px solid var(--stroke);
    background: var(--surface);
    box-shadow: 5px 5px 0 var(--shadow);
  }

  .bubble::before,
  .bubble::after {
    content: '';
    position: absolute;
    left: 2rem;
    width: 0;
    height: 0;
    border-style: solid;
  }

  .bubble::before {
    top: -1rem;
    border-width: 0 0.7rem 1rem 0.7rem;
    border-color: transparent transparent var(--stroke) transparent;
  }

  .bubble::after {
    top: calc(-1rem + 3.5px);
    border-width: 0 0.7rem 1rem 0.7rem;
    border-color: transparent transparent var(--surface) transparent;
  }

  .bubble p {
    margin: 0;
    font-size: 1rem;
  }

  .bubble p + p {
    margin-top: 0.9rem;
    color: var(--muted);
  }

  .about-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 1.7rem 0 0;
    padding: 0;
    list-style: none;
  }

  .about-badges li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.42rem 0.7rem;
    border: 2px solid var(--stroke);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .about-badges .ico {
    color: var(--red);
  }

  .about-card {
    position: relative;
    display: grid;
    gap: 0.9rem;
    align-content: start;
    overflow: hidden;
    padding: 1.5rem 1.25rem 1.6rem;
    border: 2px solid var(--ink);
    background: var(--red);
    color: #fff;
    box-shadow: 6px 6px 0 var(--stroke);
  }

  .about-card-kana {
    position: absolute;
    right: -0.1em;
    top: -0.12em;
    font-family: var(--font-display);
    font-size: 4.2rem;
    line-height: 1;
    white-space: nowrap;
    color: rgb(0 0 0 / 0.14);
    pointer-events: none;
  }

  .about-card-title {
    position: relative;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.7rem;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .about-card-desc {
    position: relative;
    margin: 0 0 0.4rem;
    font-weight: 500;
  }

  .about-card .btn {
    box-shadow: 4px 4px 0 var(--ink);
    border-color: var(--ink);
  }

  .about-card .btn:hover {
    box-shadow: 6px 6px 0 var(--ink);
  }

  .about-card .btn-ghost {
    --btn-bg: var(--paper);
    --btn-fg: var(--ink);
  }

  /* ── FAQ ────────────────────────────────────────────────────── */
  .faq-section {
    background: var(--bg-alt);
    border-block: 2px solid var(--stroke);
  }

  .faq-inner {
    display: grid;
    gap: 0.5rem;
  }

  .faq-list {
    display: grid;
    gap: 0.75rem;
    counter-reset: faq;
  }

  .faq-item {
    counter-increment: faq;
    border: 2px solid var(--stroke);
    background: var(--surface);
    transition: box-shadow 160ms ease;
  }

  .faq-item[open] {
    box-shadow: 5px 5px 0 var(--shadow);
  }

  .faq-question {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 1rem;
    font-weight: 800;
    font-size: 0.98rem;
    line-height: 1.3;
    cursor: pointer;
    list-style: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question::before {
    content: 'Q' counter(faq);
    flex: none;
    font-family: var(--font-display);
    font-size: 0.9rem;
    color: var(--red);
  }

  .faq-question > span {
    flex: 1;
  }

  .faq-plus {
    width: 1.5rem;
    height: 1.5rem;
    padding: 0.25rem;
    background: var(--yellow);
    color: var(--ink);
    border: 2px solid var(--ink);
    transition: transform 200ms ease;
  }

  .faq-item[open] .faq-plus {
    transform: rotate(45deg);
  }

  .faq-answer {
    margin: 0;
    padding: 0 1rem 1.1rem 1rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .faq-link {
    color: var(--text);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--red);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  /* ── Contacto ───────────────────────────────────────────────── */
  .contact-section {
    overflow: hidden;
    isolation: isolate;
  }

  .contact-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(var(--red) 1.6px, transparent 2px);
    background-size: 11px 11px;
    -webkit-mask-image: linear-gradient(20deg, #000, transparent 30%);
    mask-image: linear-gradient(20deg, #000, transparent 30%);
    opacity: 0.5;
  }

  .contact-inner {
    display: grid;
    gap: 2.5rem;
  }

  .contact-title {
    font-size: clamp(1.7rem, 7.2vw, 3rem);
  }

  .perks {
    display: grid;
    gap: 0.9rem;
    margin: 1.8rem 0 0;
    padding: 0;
    list-style: none;
  }

  .perk {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .perk-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.8rem;
    height: 2.8rem;
    border: 2px solid var(--ink);
    background: var(--yellow);
    color: var(--ink);
    box-shadow: 3px 3px 0 var(--shadow);
  }

  .perk-icon .ico {
    width: 1.3rem;
    height: 1.3rem;
  }

  .perk strong {
    display: block;
    font-weight: 800;
    line-height: 1.25;
  }

  .perk p {
    margin: 0.1rem 0 0;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .ballot {
    border: 2px solid var(--stroke);
    background: var(--surface);
    box-shadow: 6px 6px 0 var(--shadow);
  }

  .ballot-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 1rem 0.7rem;
    background: var(--text);
    color: var(--bg);
    font-family: var(--font-display);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .ballot-head-jp {
    color: var(--red);
  }

  .ballot-body {
    display: grid;
    gap: 1rem;
    padding: 1.2rem 1rem 1.3rem;
  }

  .form-row {
    display: grid;
    gap: 1rem;
  }

  .form-field {
    display: grid;
    gap: 0.4rem;
  }

  .form-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .form-optional {
    color: var(--muted);
  }

  .form-input {
    width: 100%;
    min-height: 3rem;
    padding: 0.7rem 0.85rem;
    border: 2px solid var(--stroke);
    border-radius: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 500;
    appearance: none;
    -webkit-appearance: none;
    transition:
      box-shadow 140ms ease,
      border-color 140ms ease;
  }

  .form-input::placeholder {
    color: var(--muted);
    opacity: 0.75;
  }

  .form-input:focus {
    outline: none;
    border-color: var(--yellow);
    box-shadow: 4px 4px 0 var(--yellow);
  }

  html[data-theme='light'] .form-input:focus {
    border-color: var(--ink);
    box-shadow: 4px 4px 0 var(--red);
  }

  .form-select {
    padding-right: 2.6rem;
    background-image:
      linear-gradient(45deg, transparent 50%, var(--text) 50%),
      linear-gradient(135deg, var(--text) 50%, transparent 50%);
    background-position:
      calc(100% - 1.25rem) 50%,
      calc(100% - 0.85rem) 50%;
    background-size:
      0.4rem 0.4rem,
      0.4rem 0.4rem;
    background-repeat: no-repeat;
  }

  .form-disclaimer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.78rem;
    text-align: center;
  }

  /* ── Footer ─────────────────────────────────────────────────── */
  .site-footer {
    position: relative;
    overflow: hidden;
    border-top: 2px solid var(--stroke);
    background: var(--bg-alt);
    padding-block: 3rem 6.5rem;
  }

  .footer-kanji {
    position: absolute;
    right: -0.05em;
    bottom: -0.28em;
    font-family: var(--font-display);
    font-size: clamp(9rem, 38vw, 22rem);
    line-height: 1;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 2px var(--hair);
    pointer-events: none;
    user-select: none;
  }

  .footer-inner {
    position: relative;
    display: grid;
    gap: 1.6rem;
    justify-items: start;
  }

  .footer-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1;
    text-transform: uppercase;
  }

  .footer-tagline {
    margin: 0.5rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
  }

  .footer-links a {
    color: var(--text);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    padding-block: 0.3rem;
  }

  .footer-links a:hover {
    color: var(--red);
  }

  .footer-copy {
    margin: 0;
    color: var(--muted);
    font-size: 0.8rem;
  }

  /* ── WhatsApp FAB ───────────────────────────────────────────── */
  .whatsapp-fab {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 60;
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--wa);
    color: var(--ink);
    box-shadow: 4px 4px 0 var(--shadow);
    transition:
      transform 140ms ease,
      box-shadow 140ms ease;
  }

  .whatsapp-fab svg {
    width: 1.7rem;
    height: 1.7rem;
  }

  .whatsapp-fab:hover {
    transform: translate(-2px, -2px) rotate(-6deg);
    box-shadow: 6px 6px 0 var(--shadow);
  }

  /* ── Reveal on scroll (only when JS is on) ──────────────────── */
  html.js .reveal {
    opacity: 0;
    translate: 0 1.4rem;
    transition:
      opacity 520ms ease,
      translate 520ms cubic-bezier(0.2, 0.8, 0.2, 1),
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  html.js .reveal.is-in {
    opacity: 1;
    translate: 0 0;
  }

  /* ── ≥ 480px ────────────────────────────────────────────────── */
  @media (min-width: 480px) {
    .hero-cta-row {
      display: flex;
      flex-wrap: wrap;
    }

    .hero-cta-row .btn {
      padding-inline: 1.3rem;
    }

    .merch-body {
      padding: 1rem;
    }

    .tag-plain {
      display: inline-block;
    }

    .merch-visual {
      height: 8rem;
    }

    .merch-kana {
      font-size: 3.4rem;
    }
  }

  /* ── ≥ 640px ────────────────────────────────────────────────── */
  @media (min-width: 640px) {
    .wrap {
      padding-inline: 1.5rem;
    }

    .section {
      padding-block: 5.5rem;
    }

    .hero-trust li {
      flex-direction: row;
      justify-content: center;
      gap: 0.6rem;
      padding: 0.95rem 0.6rem;
      font-size: 0.76rem;
    }

    .merch-grid {
      gap: 1.25rem;
    }

    .btn-extra {
      display: inline;
    }

    .merch-title {
      font-size: 1.2rem;
    }

    .merch-desc {
      font-size: 0.9rem;
    }

    .merch-price-value {
      font-size: 1.35rem;
    }

    .how-steps {
      grid-template-columns: repeat(3, 1fr);
    }

    .how-step {
      padding: 4.4rem 1.2rem 1.5rem;
    }

    .how-num {
      left: 1.1rem;
      top: 1rem;
      font-size: 3rem;
    }

    .form-row {
      grid-template-columns: 1fr 1fr;
    }

    .ballot-body {
      padding: 1.6rem 1.5rem 1.7rem;
    }

    .ballot-head {
      padding-inline: 1.5rem;
    }

    .manga-rail {
      padding-inline: 1.5rem;
      scroll-padding-inline: 1.5rem;
    }

    .manga-card {
      width: 11.5rem;
    }
  }

  /* ── ≥ 900px (desktop) ──────────────────────────────────────── */
  @media (min-width: 900px) {
    .nav-links {
      display: flex;
    }

    .nav-inner {
      min-height: 4.25rem;
    }

    .hero-inner {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      grid-template-areas:
        'copy art'
        'trust trust';
      align-items: center;
      gap: 3rem 2rem;
      padding-block: 4.5rem 4rem;
    }

    .hero-copy {
      grid-area: copy;
    }

    .hero-art {
      grid-area: art;
    }

    .hero-trust {
      grid-area: trust;
    }

    .hero-title {
      font-size: clamp(2.6rem, 4.7vw, 4.5rem);
    }

    .hero-title-line {
      white-space: nowrap;
    }

    .hero-title-place {
      font-size: clamp(1.05rem, 1.7vw, 1.45rem);
    }

    .hero-lead {
      font-size: 1.12rem;
    }

    .hero-kanji {
      right: 0.02em;
      bottom: auto;
      top: 50%;
      translate: 0 -50%;
      font-size: clamp(16rem, 27vw, 26rem);
    }

    .hero-dots {
      -webkit-mask-image: linear-gradient(215deg, #000 0%, transparent 30%);
      mask-image: linear-gradient(215deg, #000 0%, transparent 30%);
    }

    .fan {
      width: min(100%, 30rem);
    }

    .fan-card {
      box-shadow: 8px 8px 0 var(--shadow);
    }

    .sticker-burst {
      font-size: 0.95rem;
    }

    .sticker-stamp {
      font-size: 1rem;
    }

    .hero-logo {
      width: 5.5rem;
      height: 5.5rem;
    }

    .hero-brand-text b {
      font-size: 2rem;
    }

    .ticker-item {
      font-size: 1.15rem;
      padding-block: 0.75rem 0.85rem;
    }

    .section {
      padding-block: 7rem;
    }

    .sec-head {
      margin-bottom: 3rem;
    }

    .merch-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .merch-card {
      box-shadow: 6px 6px 0 var(--shadow);
    }

    .merch-visual {
      height: 10rem;
    }

    .merch-icon {
      width: 4.4rem;
      height: 4.4rem;
    }

    .merch-icon svg {
      width: 2.2rem;
      height: 2.2rem;
    }

    .merch-body {
      padding: 1.2rem;
    }

    .btn-extra {
      display: none;
    }

    .how {
      margin-top: 6rem;
    }

    .how-steps {
      gap: 1.25rem;
    }

    .how-step:nth-child(2) {
      translate: 0 1.2rem;
    }

    .how-note {
      margin-top: 2.8rem;
      text-align: center;
    }

    .manga-rail {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 1.4rem;
      overflow: visible;
    }

    .manga-card {
      width: auto;
      max-width: none;
    }

    .manga-note-swipe {
      display: none;
    }

    .manga-note {
      justify-content: center;
      margin-top: 1.5rem;
    }

    .about-inner {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
      align-items: center;
      gap: 4rem;
    }

    .about-card {
      padding: 2.2rem 1.8rem 2.3rem;
      transform: rotate(1.5deg);
    }

    .faq-inner {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
