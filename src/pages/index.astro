    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    padding-block: 0.4rem;
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: var(--red);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 180ms ease;
  }

  .nav-links a:hover::after {
    transform: scaleX(1);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 2px solid var(--stroke);
    background: var(--bg);
    color: var(--text);
    cursor: pointer;
    transition:
      background-color 140ms ease,
      color 140ms ease;
  }

  .theme-toggle:hover {
    background: var(--text);
    color: var(--bg);
  }

  .theme-icon {
    display: grid;
    width: 1.15rem;
    height: 1.15rem;
  }

  .theme-icon[hidden] {
    display: none;
  }

  /* ── Hero ───────────────────────────────────────────────────── */
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .hero-lines {
    position: absolute;
    inset: -30%;
    background: repeating-conic-gradient(
      from 0deg at 72% 46%,
      var(--dot) 0deg 0.45deg,
      transparent 0.45deg 4deg
    );
    -webkit-mask-image: radial-gradient(
      circle at 72% 46%,
      transparent 0 16%,
      #000 62%
    );
    mask-image: radial-gradient(circle at 72% 46%, transparent 0 16%, #000 62%);
    opacity: 0.75;
  }

  .hero-dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--red) 1.6px, transparent 2px);
    background-size: 11px 11px;
    -webkit-mask-image: linear-gradient(
      200deg,
      #000 0%,
      transparent 34%,
      transparent 100%
    );
    mask-image: linear-gradient(200deg, #000 0%, transparent 34%, transparent 100%);
    opacity: 0.55;
  }

  .hero-kanji {
    position: absolute;
    right: -0.08em;
    bottom: -0.2em;
    font-family: var(--font-display);
    font-size: clamp(11rem, 44vw, 30rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 2px var(--hair);
    writing-mode: vertical-rl;
    user-select: none;
  }

  .hero-inner {
    display: grid;
    gap: 2rem;
    padding-block: 2.25rem 2.5rem;
  }

  .hero-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.2rem, 10.6vw, 5.4rem);
    line-height: 1.02;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .hero-title-line {
    display: block;
  }

  .hero-title-accent {
    color: var(--red-text);
  }

  .hero-title-place {
    display: inline-block;
    margin-top: 0.85rem;
    padding: 0.45em 0.7em 0.5em;
    background: var(--yellow);
    color: var(--ink);
    border: 2px solid var(--ink);
    font-size: clamp(0.82rem, 3.7vw, 1.35rem);
    line-height: 1.1;
    letter-spacing: 0.01em;
    transform: rotate(-2deg);
    box-shadow: 4px 4px 0 var(--shadow);
  }

  .hero-title-place b {
    font-weight: 400;
  }

  .hero-lead {
    margin: 1.5rem 0 0;
    max-width: 34rem;
    font-size: 1.02rem;
    color: var(--muted);
  }

  .hero-lead strong {
    color: var(--text);
    font-weight: 700;
  }

  .hero-lead .hl-text {
    background: linear-gradient(transparent 62%, color-mix(in srgb, var(--red) 55%, transparent) 62%);
  }

  .hero-cta-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem;
    margin-top: 1.6rem;
  }

  .hero-cta-row .btn {
    padding-inline: 0.6rem;
  }

  /* Price board (hero) */
  .hero-art {
    position: relative;
  }

  .board {
    position: relative;
    width: min(100%, 22rem);
    margin-inline: auto;
    padding: 1.6rem 1.6rem 2.6rem 1rem;
  }

  .board-card {
    position: relative;
    border: 2px solid var(--stroke);
    background: var(--surface);
    box-shadow: 6px 6px 0 var(--shadow);
    transform: rotate(-2deg);
  }

  .board-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin: 0;
    padding: 0.8rem 4.2rem 0.8rem 1rem;
    background: var(--red);
    color: #fff;
    border-bottom: 2px solid var(--stroke);
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 5vw, 1.35rem);
    text-transform: uppercase;
    line-height: 1.1;
  }

  .board-rows {
    display: grid;
    margin: 0;
    padding: 0.4rem 1rem;
    list-style: none;
  }

  .board-rows li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.7rem 0;
    border-bottom: 2px dashed var(--hair);
    font-weight: 700;
  }

  .board-rows li:last-child {
    border-bottom: 0;
  }

  .board-rows b {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.3rem, 6vw, 1.7rem);
    line-height: 1;
    color: var(--yellow);
  }

  html[data-theme='light'] .board-rows b {
    color: var(--red-text);
  }

  .board-row-best {
    margin-inline: -1rem;
    padding-inline: 1rem !important;
    background: var(--yellow);
    color: var(--ink);
  }

  .board-rows .board-row-best b {
    color: var(--ink);
  }

  .board-foot {
    margin: 0;
    padding: 0.7rem 1rem;
    border-top: 2px solid var(--stroke);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .board-foot b {
    color: var(--text);
  }

  .sticker {
    position: absolute;
    z-index: 3;
    font-family: var(--font-display);
    text-transform: uppercase;
    line-height: 1;
  }

  .sticker-burst {
    right: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 5.4rem;
    aspect-ratio: 1;
    background: var(--yellow);
    color: var(--ink);
    text-align: center;
    font-size: 0.6rem;
    transform: rotate(12deg);
    animation: wobble 5s ease-in-out infinite;
  }

  .sticker-burst b {
    display: block;
    margin-top: 0.15em;
    font-weight: 400;
    font-size: 1.35em;
    color: var(--red-text);
  }

  html[data-theme='dark'] .sticker-burst b {
    color: #dc2626;
  }

  .sticker-stamp {
    left: 0;
    bottom: 0.2rem;
    padding: 0.5em 0.75em;
    border: 2px solid var(--ink);
    background: var(--red);
    color: #fff;
    font-size: clamp(0.62rem, 2.8vw, 0.82rem);
    letter-spacing: 0.04em;
    transform: rotate(-6deg);
    box-shadow: 3px 3px 0 var(--ink);
  }

  html[data-theme='dark'] .sticker-stamp {
    box-shadow: 3px 3px 0 var(--paper);
  }

  @keyframes wobble {
    0%,
    100% {
      transform: rotate(12deg) scale(1);
    }
    50% {
      transform: rotate(4deg) scale(1.06);
    }
  }

  .hero-trust {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
    border: 2px solid var(--stroke);
    background: var(--bg);
  }

  .hero-trust li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding: 0.8rem 0.4rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.2;
    text-align: center;
    text-transform: uppercase;
  }

  .hero-trust li + li {
    border-left: 2px solid var(--stroke);
  }

  .hero-trust .ico {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--red-text);
  }

  /* ── Ticker ─────────────────────────────────────────────────── */
  .ticker {
    position: relative;
    z-index: 2;
    width: 104%;
    margin: 0.4rem -2% 0;
    overflow: hidden;
    background: var(--yellow);
    color: var(--ink);
    border-block: 2px solid var(--ink);
    transform: rotate(-1.2deg);
  }

  .ticker-track {
    display: flex;
    width: max-content;
    animation: ticker 32s linear infinite;
  }

  .ticker-group {
    display: flex;
    flex: none;
  }

  .ticker-item {
    display: inline-flex;
    align-items: center;
    gap: 1.1rem;
    padding: 0.6rem 0 0.7rem 1.1rem;
    font-family: var(--font-display);
    font-size: 0.95rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .ticker-star {
    color: #dc2626;
  }

  @keyframes ticker {
    to {
      transform: translateX(-50%);
    }
  }

  /* ── Sections ───────────────────────────────────────────────── */
  .section {
    position: relative;
    padding-block: 4rem;
  }

  .sec-head {
    max-width: 44rem;
    margin-bottom: 2rem;
  }

  .eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .eyebrow-num {
    padding: 0.15rem 0.45rem;
    background: var(--red);
    color: #fff;
    font-weight: 500;
  }

  html[data-theme='dark'] .eyebrow-num {
    color: var(--ink);
  }

  .eyebrow-jp {
    font-family: var(--font-display);
    letter-spacing: 0.05em;
    color: var(--red-text);
  }

  .sec-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.9rem, 8.4vw, 3.6rem);
    line-height: 1.12;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .hl {
    display: inline-block;
    padding: 0 0.22em 0.06em;
    background: var(--yellow);
    color: var(--ink);
    transform: rotate(-1.5deg);
  }

  .hl-red {
    color: var(--red-text);
  }

  .sec-lead {
    margin: 1.1rem 0 0;
    max-width: 38rem;
    color: var(--muted);
    font-size: 1rem;
  }

  .sec-lead strong {
    color: var(--text);
  }

  .center-row {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }

  /* ── Merch ──────────────────────────────────────────────────── */
  .merch-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .merch-card {
    --tone: var(--red);
    --tone-fg: #fff;
    display: flex;
    flex-direction: column;
    border: 2px solid var(--stroke);
    background: var(--surface);
    box-shadow: 4px 4px 0 var(--shadow);
    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .merch-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 8px 8px 0 var(--shadow);
  }

  .tone-yellow {
    --tone: var(--yellow);
    --tone-fg: var(--ink);
  }

  .tone-cyan {
    --tone: var(--cyan);
    --tone-fg: var(--ink);
  }

  .tone-paper {
    --tone: var(--bg-alt);
    --tone-fg: var(--text);
  }

  .merch-visual {
    position: relative;
    display: grid;
    place-items: center;
    height: 6.5rem;
    overflow: hidden;
    background: var(--tone);
    color: var(--tone-fg);
    border-bottom: 2px solid var(--stroke);
  }

  .merch-visual::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(currentColor 1.3px, transparent 1.7px);
    background-size: 9px 9px;
    opacity: 0.22;
    -webkit-mask-image: linear-gradient(120deg, transparent 30%, #000);
    mask-image: linear-gradient(120deg, transparent 30%, #000);
  }

  .merch-kana {
    position: absolute;
    left: 0.5rem;
    bottom: -0.12em;
    font-family: var(--font-display);
    font-size: 2.6rem;
    line-height: 1;
    white-space: nowrap;
    opacity: 0.22;
  }

  .merch-icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 3.4rem;
    height: 3.4rem;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
    transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .merch-icon svg {
    width: 1.75rem;
    height: 1.75rem;
  }

  .merch-card:hover .merch-icon {
    transform: rotate(-10deg) scale(1.1);
  }

  .merch-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 0.8rem;
  }

  .merch-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tag {
    padding: 0.18rem 0.42rem;
    border: 1.5px solid var(--stroke);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .tag-stock {
    background: var(--wa);
    border-color: var(--ink);
    color: var(--ink);
  }

  .tag-soon {
    background: var(--red);
    border-color: var(--ink);
    color: #fff;
  }

  .tag-plain {
    display: none;
    color: var(--muted);
    border-color: var(--hair);
  }

  .merch-title {
    margin: 0.7rem 0 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1rem;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .merch-desc {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.45;
  }

  .merch-price {
    display: flex;
    flex-direction: column;
    margin: auto 0 0;
    padding-block: 0.85rem;
  }

  .merch-price-note {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .merch-price-value {
    font-family: var(--font-display);
    font-size: 1.1rem;
    line-height: 1.25;
    color: var(--yellow);
  }

  html[data-theme='light'] .merch-price-value {
    color: var(--red-text);
  }

  .merch-price-combo {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--text);
  }

  .merch-price-soon {
    font-size: 0.95rem;
  }

  .merch-card:first-child {
    grid-column: 1 / -1;
  }

  .merch-body .btn {
    min-height: 2.75rem;
    padding-inline: 0.5rem;
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    box-shadow: 3px 3px 0 var(--shadow);
  }

  .btn-extra {
    display: none;
  }

  /* ── Cómo comprar ───────────────────────────────────────────── */
  .how {
    margin-top: 4rem;
  }

  .how-title {
    margin: 0 0 1.5rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.6rem, 7vw, 2.6rem);
    line-height: 1.1;
    text-transform: uppercase;
  }

  .how-steps {
    display: grid;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .how-step {
    position: relative;
    overflow: hidden;
    padding: 1.2rem 1.1rem 1.3rem 5.2rem;
    border: 2px solid var(--stroke);
    background: var(--surface);
  }

  .how-step::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    width: 7rem;
    height: 7rem;
    background-image: radial-gradient(var(--dot) 1.4px, transparent 1.8px);
    background-size: 8px 8px;
    -webkit-mask-image: linear-gradient(315deg, #000, transparent 70%);
    mask-image: linear-gradient(315deg, #000, transparent 70%);
    pointer-events: none;
  }

  .how-num {
    position: absolute;
    left: 0.9rem;
    top: 0.85rem;
    font-family: var(--font-display);
    font-size: 2.6rem;
    line-height: 1;
    color: var(--red-text);
  }

  .how-kana {
    display: block;
    font-family: var(--font-display);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    color: var(--muted);
  }

  .how-heading {
    margin: 0.2rem 0 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.05rem;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .how-desc {
    margin: 0.45rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .how-note {
    margin: 1.4rem 0 0;
    padding: 0.85rem 1rem;
    border: 2px dashed var(--stroke);
    font-size: 0.9rem;
    color: var(--muted);
  }

  .how-note b {
    color: var(--text);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .catalog-preview-item {
    display: none;
  }

  .catalog-preview-item.is-active {
    display: flex;
  }

  /* ── Nosotros ───────────────────────────────────────────────── */
  .about-inner {
    display: grid;
    gap: 2.5rem;
  }

  .bubble {
    position: relative;
    margin-top: 1.6rem;
    padding: 1.15rem 1.2rem;
    border: 2px solid var(--stroke);
    background: var(--surface);
    box-shadow: 5px 5px 0 var(--shadow);
  }

  .bubble::before,
  .bubble::after {
    content: '';
    position: absolute;
    left: 2rem;
    width: 0;
    height: 0;
    border-style: solid;
  }

  .bubble::before {
    top: -1rem;
    border-width: 0 0.7rem 1rem 0.7rem;
    border-color: transparent transparent var(--stroke) transparent;
  }

  .bubble::after {
    top: calc(-1rem + 3.5px);
    border-width: 0 0.7rem 1rem 0.7rem;
    border-color: transparent transparent var(--surface) transparent;
  }

  .bubble p {
    margin: 0;
    font-size: 1rem;
  }

  .bubble p + p {
    margin-top: 0.9rem;
    color: var(--muted);
  }

  .about-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 1.7rem 0 0;
    padding: 0;
    list-style: none;
  }

  .about-badges li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.42rem 0.7rem;
    border: 2px solid var(--stroke);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .about-badges .ico {
    color: var(--red-text);
  }

  .about-card {
    position: relative;
    display: grid;
    gap: 0.9rem;
    align-content: start;
    overflow: hidden;
    padding: 1.5rem 1.25rem 1.6rem;
    border: 2px solid var(--ink);
    background: var(--red);
    color: #fff;
    box-shadow: 6px 6px 0 var(--stroke);
  }

  .about-card-kana {
    position: absolute;
    right: -0.1em;
    top: -0.12em;
    font-family: var(--font-display);
    font-size: 4.2rem;
    line-height: 1;
    white-space: nowrap;
    color: rgb(0 0 0 / 0.14);
    pointer-events: none;
  }

  .about-card-title {
    position: relative;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.7rem;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .about-card-desc {
    position: relative;
    margin: 0 0 0.4rem;
    font-weight: 500;
  }

  .about-card .btn {
    box-shadow: 4px 4px 0 var(--ink);
    border-color: var(--ink);
  }

  .about-card .btn:hover {
    box-shadow: 6px 6px 0 var(--ink);
  }

  .about-card .btn-ghost {
    --btn-bg: var(--paper);
    --btn-fg: var(--ink);
  }

  /* ── FAQ ────────────────────────────────────────────────────── */
  .faq-section {
    background: var(--bg-alt);
    border-block: 2px solid var(--stroke);
  }

  .faq-inner {
    display: grid;
    gap: 0.5rem;
  }

  .faq-list {
    display: grid;
    gap: 0.75rem;
    counter-reset: faq;
  }

  .faq-item {
    counter-increment: faq;
    border: 2px solid var(--stroke);
    background: var(--surface);
    transition: box-shadow 160ms ease;
  }

  .faq-item[open] {
    box-shadow: 5px 5px 0 var(--shadow);
  }

  .faq-question {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 1rem;
    font-weight: 800;
    font-size: 0.98rem;
    line-height: 1.3;
    cursor: pointer;
    list-style: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question::before {
    content: 'Q' counter(faq);
    flex: none;
    font-family: var(--font-display);
    font-size: 0.9rem;
    color: var(--red-text);
  }

  .faq-question > span {
    flex: 1;
  }

