  clock: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>',
  gift: '<path d="M20 12v10H4V12"/><rect width="20" height="5" x="2" y="7"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/>',
  check:
    '<path d="m9 11 3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>',
  lock: '<rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
  instagram:
    '<rect width="20" height="20" x="2" y="2" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><path d="M17.5 6.5h.01"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.93 4.93l2.12 2.12M16.95 16.95l2.12 2.12M4.93 19.07l2.12-2.12M16.95 7.05l2.12-2.12"/>',
  moon: '<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/>',
  plus: '<path d="M12 5v14"/><path d="M5 12h14"/>',
};

const merch = [
  {
    id: 'posters',
    kana: 'ポスター',
    icon: icons.poster,
    tone: 'red',
    stock: 'En stock',
    tag: 'Varios tamaños',
    title: 'Posters Anime',
    desc: 'Tus series favoritas en tu pared. Impresión de alta calidad, colores vivos y varios tamaños.',
    priceNote: 'Precio',
    price: 'Según tamaño',
    href: wa('Hola Tansaku! ¿Me mandas fotos de los posters disponibles?'),
    cta: 'Ver diseños',
    soon: false,
  },
  {
    id: 'pines',
