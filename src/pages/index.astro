    color: var(--text);
  }

  /* Logo horizontal tal cual (guía de marca §07): sin giro, borde, sombra
     ni efectos. Versión de texto claro en oscuro y de texto negro en claro.
     30px de alto → 112px de ancho (mínimo 110px) y 15px de espacio libre
     (mitad del sello) arriba y abajo dentro de la barra de 60px. */
  .brand-logo {
    display: block;
    flex: none;
    width: auto;
    height: 30px;
  }

  html[data-theme='dark'] .brand-logo-dark,
