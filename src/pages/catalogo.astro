---
import { Image } from 'astro:assets';
import '../styles/global.css';
import logoDark from '../assets/logos/horizontal.png';
import logoLight from '../assets/logos/horizontal-claro.png';
import { WHATSAPP_NUMBER } from '../lib/shop';

const currentYear = new Date().getFullYear();
const INSTAGRAM_URL = 'https://www.instagram.com/tansakustore';
const whatsappGeneral = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(
  'Hola Tansaku! ¿Qué tienen disponible?',
)}`;

const WA_ICON =
  'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z';

const icons = {
  search: '<circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/>',
  sliders:
    '<path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0"/><circle cx="16" cy="6" r="2"/><circle cx="10" cy="12" r="2"/><circle cx="18" cy="18" r="2"/>',
  close: '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>',
  left: '<path d="m15 18-6-6 6-6"/>',
  right: '<path d="m9 18 6-6-6-6"/>',
  truck:
    '<path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62L18.3 9.38a1 1 0 0 0-.78-.38H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/>',
  check:
    '<path d="m9 11 3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.93 4.93l2.12 2.12M16.95 16.95l2.12 2.12M4.93 19.07l2.12-2.12M16.95 7.05l2.12-2.12"/>',
  moon: '<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/>',
  arrow: '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
};
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/tk.ico" />
    <title>Catálogo | Tansaku — Pósters y stickers de anime</title>
    <meta
      name="description"
      content="Catálogo de Tansaku: pósters y stickers de anime en San Pedro de Macorís. Filtra por categoría y precio, pide por WhatsApp y pagas al recibir."
    />
    <link rel="canonical" href="https://tansaku.site/catalogo/" />
    <meta name="theme-color" content="#0b1118" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://tansaku.site/catalogo/" />
    <meta property="og:site_name" content="Tansaku" />
    <meta property="og:locale" content="es_DO" />
    <meta property="og:title" content="Catálogo Tansaku | Pósters y stickers de anime" />
    <meta
      property="og:description"
      content="Mira todo lo disponible, filtra por categoría y precio, y pide por WhatsApp."
    />
    <meta property="og:image" content="https://tansaku.site/og.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Dela+Gothic+One&family=Inter:wght@500;600;700;800&family=Noto+Sans+JP:wght@700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      try {
        const t = localStorage.getItem('tansaku-theme');
        if (t === 'light' || t === 'dark')
          document.documentElement.setAttribute('data-theme', t);
      } catch {}
    </script>
  </head>
  <body>
    <template id="tpl-wa"
      ><svg class="ico" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
        ><path d={WA_ICON} /></svg
      ></template
    >

    <header class="nav">
      <div class="wrap nav-inner">
        <a href="/" class="brand" aria-label="Tansaku — inicio">
          <Image src={logoDark} alt="Tansaku" class="brand-logo brand-logo-dark" widths={[128, 256]} sizes="128px" format="webp" loading="eager" />
          <Image src={logoLight} alt="Tansaku" class="brand-logo brand-logo-light" widths={[128, 256]} sizes="128px" format="webp" loading="eager" />
        </a>
        <nav class="nav-links" aria-label="Secciones">
          <a href="/">Inicio</a>
          <a href="/#merch">Merch</a>
          <a href="/#catalogo">Manga</a>
          <a href="/#contacto">Pide tu serie</a>
          <a href="/#faq">FAQ</a>
        </nav>
        <div class="nav-actions">
          <button
            type="button"
            id="theme-toggle"
            class="theme-toggle"
            aria-label="Cambiar tema"
          >
            <span id="theme-icon-sun" class="theme-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons.sun} />
            </span>
            <span id="theme-icon-moon" class="theme-icon" aria-hidden="true" hidden>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons.moon} />
            </span>
          </button>
          <a
            href={whatsappGeneral}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-wa btn-sm"
          >
            <svg class="ico" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={WA_ICON} /></svg>
            <span class="nav-wa-label">Escríbenos</span>
          </a>
        </div>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="hero-bg" aria-hidden="true">
          <div class="hero-dots"></div>
          <span class="hero-kana">カタログ</span>
        </div>
        <div class="wrap hero-inner">
          <p class="eyebrow">
            <span class="chip-dot"></span> Disponible ya
            <span class="eyebrow-jp">在庫あり</span>
          </p>
          <h1 class="hero-title">Catálogo <span class="hl">Tansaku</span></h1>
          <p class="hero-lead">
            Todo lo que tenemos ahora mismo. Filtra, elige y pide por WhatsApp —
            entrega gratis en San Pedro de Macorís y <strong>pagas al recibir</strong>.
          </p>
        </div>
      </section>

      <div class="wrap layout">
        <form id="filters" class="filters" autocomplete="off" role="search">
          <div class="toolbar">
            <div class="search-row">
              <label class="search">
                <span class="sr-only">Buscar</span>
                <svg class="ico search-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.search} />
                <input
                  id="f-q"
                  name="q"
                  type="search"
                  placeholder="Busca: Chainsaw Man, poster…"
                />
              </label>
              <button
                type="button"
                id="filters-toggle"
                class="filters-toggle"
                aria-expanded="false"
                aria-controls="filters-panel"
              >
                <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.sliders} />
                <span class="sr-only">Filtros y orden</span>
                <span id="filters-badge" class="filters-badge" hidden></span>
              </button>
            </div>

            <fieldset class="field cats-field">
              <legend class="field-label cats-legend">Categoría</legend>
              <div id="f-categories" class="chips cats">
                <button type="button" class="chip is-active" data-category=""
                  >Todas</button
                >
              </div>
            </fieldset>
          </div>

          <div id="sheet-backdrop" class="sheet-backdrop" hidden></div>
          <div id="filters-panel" class="sheet" aria-label="Filtros">
            <div class="sheet-head">
              <span class="sheet-title">Filtros <span class="eyebrow-jp">フィルター</span></span>
              <button type="button" id="sheet-close" class="icon-btn" aria-label="Cerrar filtros">
                <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true" set:html={icons.close} />
              </button>
            </div>

            <fieldset class="field">
              <legend class="field-label">Precio (RD$)</legend>
              <div class="price-row">
                <input
                  id="f-min"
                  name="min"
                  type="number"
                  inputmode="numeric"
                  min="0"
                  placeholder="Mín"
                  aria-label="Precio mínimo"
                  class="input"
                />
                <span aria-hidden="true">—</span>
                <input
                  id="f-max"
                  name="max"
                  type="number"
                  inputmode="numeric"
                  min="0"
                  placeholder="Máx"
                  aria-label="Precio máximo"
                  class="input"
                />
              </div>
              <div id="f-price-presets" class="chips chips-sm">
                <button type="button" class="chip" data-min="" data-max="200"
                  >Hasta 200</button
                >
                <button type="button" class="chip" data-min="200" data-max="500"
                  >200 – 500</button
                >
                <button type="button" class="chip" data-min="500" data-max=""
                  >500+</button
                >
              </div>
            </fieldset>

            <div class="field">
              <label for="f-sort" class="field-label">Ordenar por</label>
              <select id="f-sort" name="sort" class="input select">
                <option value="recent">Más recientes</option>
                <option value="price-asc">Precio: menor a mayor</option>
                <option value="price-desc">Precio: mayor a menor</option>
                <option value="name">Nombre (A–Z)</option>
              </select>
            </div>

            <label class="switch">
              <input id="f-stock" name="stock" type="checkbox" />
              <span class="switch-track" aria-hidden="true"></span>
              Solo disponibles
            </label>

            <div class="sheet-actions">
              <button type="button" id="f-reset" class="btn btn-ghost">
                Limpiar
              </button>
              <button type="button" id="f-apply" class="btn btn-primary sheet-apply">
                Ver productos
              </button>
            </div>
          </div>
        </form>

        <section class="results" aria-live="polite">
          <p id="results-count" class="count">Cargando…</p>
          <div id="results-grid" class="grid">
            {
              Array.from({ length: 6 }, () => (
                <div class="card card-skeleton" aria-hidden="true">
                  <div class="card-media" />
                  <div class="card-body">
                    <span class="sk-line" />
                    <span class="sk-line sk-short" />
                  </div>
                </div>
              ))
            }
          </div>
          <div id="results-empty" class="empty" hidden>
            <span class="empty-kana" aria-hidden="true">なし…</span>
            <p class="empty-title">No hay nada con esos filtros</p>
            <p>Prueba otra categoría o un rango de precio distinto.</p>
          </div>
          <div id="results-error" class="empty" hidden>
            <span class="empty-kana" aria-hidden="true">準備中</span>
            <p class="empty-title">El catálogo se está preparando</p>
            <p>
              Mientras tanto, escríbenos y te mandamos fotos de todo lo
              disponible.
            </p>
            <a
              class="btn btn-wa"
              href={whatsappGeneral}
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg class="ico" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={WA_ICON} /></svg>
              Escribir por WhatsApp
            </a>
          </div>
        </section>
      </div>
    </main>

    <dialog id="product-dialog" class="pd" aria-labelledby="d-title">
      <div class="pd-inner">
        <button type="button" class="icon-btn pd-close" id="d-close" aria-label="Cerrar">
          <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true" set:html={icons.close} />
        </button>
        <div class="pd-gallery">
          <div id="d-track" class="pd-track" tabindex="0"></div>
          <button type="button" id="d-prev" class="pd-nav is-prev" aria-label="Foto anterior">
            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.left} />
          </button>
          <button type="button" id="d-next" class="pd-nav is-next" aria-label="Foto siguiente">
            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.right} />
          </button>
          <div id="d-dots" class="pd-dots"></div>
        </div>
        <div class="pd-body">
          <span id="d-cat" class="tag tag-cat"></span>
          <h2 id="d-title" class="pd-title"></h2>
          <p id="d-price" class="pd-price"></p>
          <p id="d-out" class="pd-out" hidden>
            Agotado por ahora — escríbenos y te avisamos cuando vuelva.
          </p>
          <p id="d-desc" class="pd-desc"></p>
          <ul class="pd-perks">
            <li>
              <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.truck} />
              Entrega gratis en San Pedro de Macorís
            </li>
            <li>
              <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.check} />
              Pagas al recibir, con el producto en la mano
            </li>
          </ul>
          <a
            id="d-wa"
            class="btn btn-wa btn-block btn-lg"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="ico" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={WA_ICON} /></svg>
            <span id="d-wa-label">Pedir por WhatsApp</span>
          </a>
        </div>
      </div>
    </dialog>

    <footer class="site-footer">
      <div class="footer-kanji" aria-hidden="true">探索</div>
      <div class="wrap footer-inner">
        <div>
          <p class="footer-name">Tansaku</p>
          <p class="footer-tagline">Pósters y stickers de anime · San Pedro de Macorís</p>
        </div>
        <nav class="footer-links" aria-label="Pie de página">
          <a href="/">Inicio</a>
          <a href="/#como-comprar">Cómo comprar</a>
          <a href="/#faq">FAQ</a>
          <a href="/#contacto">Pide tu serie</a>
          <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">Instagram</a>
        </nav>
        <p class="footer-copy">© {currentYear} Tansaku · Hecho con ❤️ en RD</p>
      </div>
    </footer>

    <a
      href={whatsappGeneral}
      target="_blank"
      rel="noopener noreferrer"
      class="whatsapp-fab"
      aria-label="Escríbenos por WhatsApp"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={WA_ICON} /></svg>
    </a>

    <script>
      import {
        getClient,
        imageUrl,
        formatPrice,
        productImages,
        whatsappLink,
        type Product,
      } from '../lib/shop';

      const $ = <T extends HTMLElement>(id: string) =>
        document.getElementById(id) as T;

      const waIcon = () =>
        ($<HTMLTemplateElement>('tpl-wa').content.firstElementChild as Element).cloneNode(
          true,
        );

      // ── Theme toggle (same key as the home page) ──
      const root = document.documentElement;
      function applyTheme(theme: 'dark' | 'light', persist: boolean) {
        root.dataset.theme = theme;
        $('theme-toggle').setAttribute('aria-pressed', String(theme === 'dark'));
        $('theme-icon-sun').hidden = theme !== 'dark';
        $('theme-icon-moon').hidden = theme === 'dark';
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', theme === 'dark' ? '#0b1118' : '#fff6e5');
        if (!persist) return;
        try {
          localStorage.setItem('tansaku-theme', theme);
        } catch {}
      }
      applyTheme(root.dataset.theme === 'light' ? 'light' : 'dark', false);
      $('theme-toggle').addEventListener('click', () =>
        applyTheme(root.dataset.theme === 'dark' ? 'light' : 'dark', true),
      );

      const form = $<HTMLFormElement>('filters');
      const qInput = $<HTMLInputElement>('f-q');
      const minInput = $<HTMLInputElement>('f-min');
      const maxInput = $<HTMLInputElement>('f-max');
      const sortSelect = $<HTMLSelectElement>('f-sort');
      const stockInput = $<HTMLInputElement>('f-stock');
      const categoriesBox = $('f-categories');
      const presetsBox = $('f-price-presets');
      const grid = $('results-grid');
      const count = $('results-count');
      const empty = $('results-empty');
      const errorBox = $('results-error');
      const badge = $('filters-badge');
      const applyBtn = $<HTMLButtonElement>('f-apply');

      let products: Product[] = [];
      let category = '';

      const normalize = (s: string) =>
        s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();

      // ── URL <-> filters (so filtered views can be shared) ──
      function readUrl() {
        const p = new URLSearchParams(location.search);
        qInput.value = p.get('q') ?? '';
        minInput.value = p.get('min') ?? '';
        maxInput.value = p.get('max') ?? '';
        sortSelect.value = p.get('sort') ?? 'recent';
        if (!sortSelect.value) sortSelect.value = 'recent';
        stockInput.checked = p.get('stock') === '1';
        category = p.get('cat') ?? '';
      }

      function writeUrl() {
        const p = new URLSearchParams();
        if (qInput.value.trim()) p.set('q', qInput.value.trim());
        if (category) p.set('cat', category);
        if (minInput.value) p.set('min', minInput.value);
        if (maxInput.value) p.set('max', maxInput.value);
        if (sortSelect.value !== 'recent') p.set('sort', sortSelect.value);
        if (stockInput.checked) p.set('stock', '1');
        const qs = p.toString();
        history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
      }

      function renderCategories() {
        const counts = new Map<string, number>();
        for (const p of products)
          counts.set(p.category, (counts.get(p.category) ?? 0) + 1);
        const names = [...counts.keys()].sort((a, b) => a.localeCompare(b, 'es'));
        if (category && !counts.has(category)) category = '';

        categoriesBox.replaceChildren(
          ...['', ...names].map((name) => {
            const b = document.createElement('button');
            b.type = 'button';
            b.className = 'chip';
            b.dataset.category = name;
            b.append(name || 'Todas');
            const n = document.createElement('span');
            n.className = 'chip-count';
            n.textContent = String(name ? counts.get(name) : products.length);
            b.append(n);
            return b;
          }),
        );
        syncChips();
      }

      function syncChips() {
        categoriesBox.querySelectorAll<HTMLButtonElement>('.chip').forEach((b) => {
          const on = b.dataset.category === category;
          b.classList.toggle('is-active', on);
          b.setAttribute('aria-pressed', String(on));
        });
        presetsBox.querySelectorAll<HTMLButtonElement>('.chip').forEach((b) => {
          const on =
            (b.dataset.min ?? '') === minInput.value &&
            (b.dataset.max ?? '') === maxInput.value;
          b.classList.toggle('is-active', on);
          b.setAttribute('aria-pressed', String(on));
        });
      }

      function el<K extends keyof HTMLElementTagNameMap>(
        tag: K,
        className: string,
        text?: string,
      ) {
        const node = document.createElement(tag);
        node.className = className;
        if (text !== undefined) node.textContent = text;
        return node;
      }

      function card(p: Product, index: number) {
        const article = el('article', 'card');
        article.style.setProperty('--i', String(Math.min(index, 12)));
        if (!p.in_stock) article.classList.add('is-out');

        const images = productImages(p);
        const media = el('button', 'card-media');
        media.type = 'button';
        media.setAttribute('aria-label', `Ver fotos y detalles de ${p.title}`);
        media.addEventListener('click', () => openProduct(p));
        const src = imageUrl(images[0] ?? null);
        if (src) {
          const img = document.createElement('img');
          img.src = src;
          img.alt = p.title;
          img.loading = 'lazy';
          img.decoding = 'async';
          media.append(img);
        } else {
          media.classList.add('is-empty');
          media.append(el('span', 'card-empty-kanji', '探索'));
        }
        media.append(el('span', 'tag tag-cat card-cat', p.category));
        if (!p.in_stock) media.append(el('span', 'card-out', 'Agotado'));
        if (images.length > 1)
          media.append(el('span', 'card-photos', `${images.length} fotos`));

        const body = el('div', 'card-body');
        const h = el('h2', 'card-title');
        const hb = el('button', '', p.title);
        hb.type = 'button';
        hb.addEventListener('click', () => openProduct(p));
        h.append(hb);
        body.append(h);
        if (p.description) body.append(el('p', 'card-desc', p.description));

        const row = el('div', 'card-row');
        const price = el('span', 'card-price', formatPrice(Number(p.price)));
        const a = el('a', `btn btn-sm ${p.in_stock ? 'btn-wa' : 'btn-ghost'}`);
        a.href = whatsappLink({ title: p.title, price: Number(p.price) });
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
        a.setAttribute(
          'aria-label',
          `${p.in_stock ? 'Pedir' : 'Avísame de'} ${p.title} por WhatsApp`,
        );
        a.append(waIcon(), el('span', '', p.in_stock ? 'Pedir' : 'Avísame'));
        row.append(price, a);
        body.append(row);

        article.append(media, body);
        return article;
      }

      // ── Product detail dialog with photo gallery ──
      const dialog = $<HTMLDialogElement>('product-dialog');
      const track = $('d-track');
      const dots = $('d-dots');
      const prev = $<HTMLButtonElement>('d-prev');
      const next = $<HTMLButtonElement>('d-next');

      function currentSlide() {
        return Math.round(track.scrollLeft / Math.max(1, track.clientWidth));
      }

      function goTo(i: number) {
        track.scrollTo({ left: i * track.clientWidth, behavior: 'smooth' });
      }

      function syncGallery() {
        const i = currentSlide();
        const total = track.children.length;
        dots.querySelectorAll('button').forEach((d, j) =>
          d.classList.toggle('is-active', j === i),
        );
        prev.disabled = i <= 0;
        next.disabled = i >= total - 1;
      }

      function openProduct(p: Product) {
        const images = productImages(p);
        const slides = images.length
          ? images.map((path, i) => {
              const img = document.createElement('img');
              img.src = imageUrl(path)!;
              img.alt = `${p.title} — foto ${i + 1} de ${images.length}`;
              img.decoding = 'async';
              return img;
            })
          : [el('div', 'pd-empty', '探索')];
        track.replaceChildren(...slides);
        dots.replaceChildren(
          ...(images.length > 1
            ? images.map((_, i) => {
                const d = document.createElement('button');
                d.type = 'button';
                d.setAttribute('aria-label', `Ver foto ${i + 1}`);
                d.addEventListener('click', () => goTo(i));
                return d;
              })
            : []),
        );
        const multi = images.length > 1;
        prev.hidden = next.hidden = dots.hidden = !multi;

        $('d-cat').textContent = p.category;
        $('d-title').textContent = p.title;
        $('d-price').textContent = formatPrice(Number(p.price));
        $('d-desc').textContent = p.description ?? '';
        $('d-out').hidden = p.in_stock;
        const wa = $<HTMLAnchorElement>('d-wa');
        wa.href = whatsappLink({ title: p.title, price: Number(p.price) });
        wa.classList.toggle('btn-wa', p.in_stock);
        wa.classList.toggle('btn-ghost', !p.in_stock);
        $('d-wa-label').textContent = p.in_stock
          ? 'Pedir por WhatsApp'
          : 'Avísame por WhatsApp';

        dialog.showModal();
        track.scrollLeft = 0;
        syncGallery();
      }

      track.addEventListener('scroll', () => requestAnimationFrame(syncGallery), {
        passive: true,
      });
      prev.addEventListener('click', () => goTo(currentSlide() - 1));
      next.addEventListener('click', () => goTo(currentSlide() + 1));
      track.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') goTo(currentSlide() - 1);
        if (e.key === 'ArrowRight') goTo(currentSlide() + 1);
      });
      $('d-close').addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
      });

      // ── Filters bottom sheet (mobile) ──
      const panel = $('filters-panel');
      const backdrop = $('sheet-backdrop');
      const toggle = $('filters-toggle');
      function setSheet(open: boolean) {
        panel.classList.toggle('is-open', open);
        backdrop.hidden = !open;
        root.classList.toggle('sheet-open', open);
        toggle.setAttribute('aria-expanded', String(open));
        if (open) sortSelect.focus({ preventScroll: true });
      }
      toggle.addEventListener('click', () =>
        setSheet(!panel.classList.contains('is-open')),
      );
      backdrop.addEventListener('click', () => setSheet(false));
      $('sheet-close').addEventListener('click', () => setSheet(false));
      applyBtn.addEventListener('click', () => {
        setSheet(false);
        $('results-count').scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && panel.classList.contains('is-open'))
          setSheet(false);
      });

      function apply() {
        const q = normalize(qInput.value.trim());
        const min = minInput.value === '' ? -Infinity : Number(minInput.value);
        const max = maxInput.value === '' ? Infinity : Number(maxInput.value);

        const list = products.filter((p) => {
          const price = Number(p.price);
          if (category && p.category !== category) return false;
          if (price < min || price > max) return false;
          if (stockInput.checked && !p.in_stock) return false;
          if (
            q &&
            !normalize(`${p.title} ${p.description ?? ''} ${p.category}`).includes(q)
          )
            return false;
          return true;
        });

        switch (sortSelect.value) {
          case 'price-asc':
            list.sort((a, b) => Number(a.price) - Number(b.price));
            break;
          case 'price-desc':
            list.sort((a, b) => Number(b.price) - Number(a.price));
            break;
          case 'name':
            list.sort((a, b) => a.title.localeCompare(b.title, 'es'));
            break;
          default:
            list.sort((a, b) => b.created_at.localeCompare(a.created_at));
        }

        grid.replaceChildren(...list.map(card));
        const label = list.length === 1 ? '1 producto' : `${list.length} productos`;
        count.textContent = label;
        applyBtn.textContent = list.length ? `Ver ${label}` : 'Sin resultados';
        empty.hidden = list.length > 0;

        const active =
          Number(minInput.value !== '' || maxInput.value !== '') +
          Number(sortSelect.value !== 'recent') +
          Number(stockInput.checked);
        badge.hidden = active === 0;
        badge.textContent = String(active);

        syncChips();
        writeUrl();
      }

      categoriesBox.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.chip');
        if (!b) return;
        category = b.dataset.category ?? '';
        apply();
      });

      presetsBox.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.chip');
        if (!b) return;
        const already = b.classList.contains('is-active');
        minInput.value = already ? '' : (b.dataset.min ?? '');
        maxInput.value = already ? '' : (b.dataset.max ?? '');
        apply();
      });

      form.addEventListener('input', apply);
      form.addEventListener('submit', (e) => e.preventDefault());
      $('f-reset').addEventListener('click', () => {
        form.reset();
        category = '';
        apply();
      });

      function showError() {
        count.textContent = '';
        grid.replaceChildren();
        errorBox.hidden = false;
      }

      async function load() {
        readUrl();
        const supabase = getClient();
        if (!supabase) return showError();
        const { data, error } = await supabase
          .from('products')
          .select('*')
          .eq('published', true)
          .order('created_at', { ascending: false });

        if (error) {
          console.error(error);
          return showError();
        }
        products = (data ?? []) as Product[];
        if (products.length === 0) return showError();
        renderCategories();
        apply();
      }

      load();
    </script>
  </body>
</html>

